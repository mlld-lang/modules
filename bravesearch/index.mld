mlld-version: ">=2.2.0"
---

>> Brave Search API tool
>> The key is looked up in the keychain first, then the BRAVE_API_KEY environment variable.

creds @brave = "BRAVE_API_KEY"

>> JS because the request needs a header and a response status check, which a
>> cmd body would push through curl for no gain.
exe @braveFetch(query, count) using creds:brave = node {
  const limit = count || 5;
  const res = await fetch(
    `https://api.search.brave.com/res/v1/web/search?q=${encodeURIComponent(query)}&count=${limit}&spellcheck=0`,
    { headers: { 'X-Subscription-Token': process.env.BRAVE_API_KEY } }
  );
  if (!res.ok) {
    return { error: true, status: res.status, message: await res.text() };
  }
  return await res.json();
}

>> Keeps the fields an agent reads from Brave's web results.
exe @shapeResults(response) = match [
  @response.error => @response
  * => for @r in (@response.web.results ?? []) => { title: @r.title, url: @r.url, snippet: @r.description }
]

exe .op:net:r @search(query: string, count: number) with { description: "Search the web using Brave Search API" } = @shapeResults(@braveFetch(@query, @count))

tools @tools = {
  search: {
    mlld: @search,
    labels: [.op:net:r],
    description: "Search the web using Brave Search API"
  }
}

export { @search, @tools, @shapeResults }
