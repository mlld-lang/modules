---
name: bravesearch
author: mlld
version: 2.0.0
about: Brave web search results tool
bugs: https://github.com/mlld-lang/modules/issues
repo: https://github.com/mlld-lang/modules
license: CC0
mlld-version: ">=2.2.0"
---

needs { js: [], network }

>> Brave Search API tool
>> The key is looked up in the keychain first, then the BRAVE_API_KEY environment
>> variable, and goes out as Brave's X-Subscription-Token header.

creds @brave = { from: "keychain", as: "BRAVE_API_KEY", auth_header: "X-Subscription-Token" }

>> js because mlld has no URL encoding for a query string.
exe @encodeQuery(text) = js {
  return encodeURIComponent(String(text));
}

exe @braveUrl(query, count) = `https://api.search.brave.com/res/v1/web/search?q=${@encodeQuery(@query)}&count=${@count || 5}&spellcheck=0`

>> A non-2xx answer comes back as { error, status, message } rather than a failure.
exe @braveResponse(res) = match [
  @res.ok => @res.body
  * => { error: true, status: @res.status, message: @res.body }
]

exe @braveFetch(query, count) = [
  let @res = @http.get(@braveUrl(@query, @count)) using creds:brave
  => @braveResponse(@res)
]

>> Keeps the fields an agent reads from Brave's web results.
exe @shapeResults(response) = match [
  @response.error => @response
  * => for @r in (@response.web.results ?? []) => { title: @r.title, url: @r.url, snippet: @r.description }
]

exe .op:net:r @search(query: string, count: number) with { description: "Search the web using Brave Search API" } = @shapeResults(@braveFetch(@query, @count))

tools @tools = {
  search: {
    mlld: @search,
    labels: [.op:net:r],
    description: "Search the web using Brave Search API"
  }
}

export { @search, @tools, @shapeResults, @braveUrl, @braveResponse }
