>> Tests for @conversation (locate + ingest).
>> Run: mlld test opencode/tests/conversation.test.mld

import { @conversation } from "../index.mld"

>> Reads a fixture raw: <file> would parse a .jsonl, changing what a truncated line does.
exe @text(p) = node { return require("fs").readFileSync(p, "utf8"); }

const @fixtures = `${@root}/opencode/tests/fixtures/conversation`
const @stub = `${@fixtures}/opencode-stub.sh`
const @failedId = "ses_f32dab56cffemtZGIZ407tXu7U"

>> Compares with key order ignored, because mlld may reorder object keys; a golden's
>> line 1 is the header and the remaining lines are the events in order.
exe @matchesGolden(result, goldenPath) = node {
  const fs = require("fs");
  const eq = (a, b) => {
    if (a === b) return true;
    if (a === null || b === null || typeof a !== "object" || typeof b !== "object") return false;
    if (Array.isArray(a) !== Array.isArray(b)) return false;
    const ka = Object.keys(a), kb = Object.keys(b);
    if (ka.length !== kb.length) return false;
    return ka.every((k) => Object.prototype.hasOwnProperty.call(b, k) && eq(a[k], b[k]));
  };
  const lines = fs.readFileSync(goldenPath, "utf8").split("\n").filter((l) => l.trim()).map((l) => JSON.parse(l));
  const [header, ...events] = lines;
  if (!eq(result.header, header)) {
    console.error("header mismatch:\n  got  " + JSON.stringify(result.header) + "\n  want " + JSON.stringify(header));
    return false;
  }
  if (result.events.length !== events.length) {
    console.error("event count: got " + result.events.length + ", want " + events.length);
    return false;
  }
  for (let i = 0; i < events.length; i++) {
    if (!eq(result.events[i], events[i])) {
      console.error("event " + i + " mismatch:\n  got  " + JSON.stringify(result.events[i]) + "\n  want " + JSON.stringify(events[i]));
      return false;
    }
  }
  return true;
}

exe @types(result) = node { return result.events.map((e) => e.type).join(","); }

>> Each locate check gets its own XDG_DATA_HOME, so the stub's marker is per-check.
exe @freshRoot() = node {
  const fs = require("fs"), os = require("os"), path = require("path");
  return fs.mkdtempSync(path.join(os.tmpdir(), "mlld-opencode-test-"));
}
exe @ran(dataHome) = node { return require("fs").existsSync(require("path").join(dataHome, "ran")); }
exe @exportId(p) = node {
  if (typeof p !== "string") return null;
  return JSON.parse(require("fs").readFileSync(p, "utf8")).info.id;
}

>> ── ingest: the hand-written goldens ──

>> A loaded file arrives as an object, not text; ingest must refuse it rather than read it.
const @rejected = try @conversation.ingest({})
const @test_ingest_rejects_path_like_object = !@rejected.ok

const @basic = @conversation.ingest(@text(`${@fixtures}/basic-resumed.export.json`))
const @failed = @conversation.ingest(@text(`${@fixtures}/failed-tool.export.json`))
const @compacted = @conversation.ingest(@text(`${@fixtures}/compacted-overflow.export.json`))

const @test_ingest_basic_resumed = @matchesGolden(@basic, `${@fixtures}/basic-resumed.opencode.jsonl`)
const @test_ingest_failed_tool = @matchesGolden(@failed, `${@fixtures}/failed-tool.opencode.jsonl`)
const @test_ingest_compacted_overflow = @matchesGolden(@compacted, `${@fixtures}/compacted-overflow.opencode.jsonl`)

const @test_sequence_basic_resumed = @types(@basic) == "session_start,message,assistant_turn,thinking,tool_call,tool_result,assistant_turn,message,assistant_turn,thinking,tool_call,tool_result,assistant_turn"
const @test_sequence_failed_tool = @types(@failed) == "session_start,message,assistant_turn,thinking,tool_call,tool_result,assistant_turn"
const @test_sequence_compacted_overflow = @types(@compacted) == "session_start,context_injection,context_injection"

>> The first turn has one tool: its thinking and call hang off the turn, the result off the call.
const @test_parent_thinking = @basic.events[3].parent_id == @basic.events[2].id
const @test_parent_tool_call = @basic.events[4].parent_id == @basic.events[2].id
const @test_parent_tool_result = @basic.events[5].parent_id == @basic.events[4].id

const @test_failed_tool_is_error = @failed.events[5].payload.is_error == true

>> Parts: tool c1, reasoning, tool c2, reasoning. The first result hangs off the last
>> call (event 4), not off the reasoning that follows it (event 5).
const @interleaved = @conversation.ingest(@text(`${@fixtures}/reasoning-after-tool.export.json`))
const @test_sequence_reasoning_after_tool = @types(@interleaved) == "session_start,assistant_turn,tool_call,thinking,tool_call,thinking,tool_result,tool_result"
const @test_parent_first_result_is_last_call = @interleaved.events[6].parent_id == @interleaved.events[4].id
const @test_parent_second_result_is_first_result = @interleaved.events[7].parent_id == @interleaved.events[6].id

>> ── locate, against a stub opencode ──

const @rootKnown = @freshRoot()
const @known = @conversation.locate(@failedId, "", @rootKnown, @stub)
const @test_locate_known = @exportId(@known) == @failedId
const @test_locate_stub_ran = @ran(@rootKnown)

const @rootUnknown = @freshRoot()
const @test_locate_unknown = @conversation.locate("ses_unknownSession123", "", @rootUnknown, @stub) == null

const @rootTraversal = @freshRoot()
const @test_locate_traversal = @conversation.locate("../x", "", @rootTraversal, @stub) == null
const @test_locate_traversal_not_run = !@ran(@rootTraversal)

const @rootFlag = @freshRoot()
const @test_locate_flag = @conversation.locate("--help", "", @rootFlag, @stub) == null
const @test_locate_flag_not_run = !@ran(@rootFlag)

const @rootCase = @freshRoot()
const @test_locate_wrong_case = @conversation.locate("SES_f32dab56cffemtZGIZ407tXu7U", "", @rootCase, @stub) == null
const @test_locate_wrong_case_not_run = !@ran(@rootCase)

>> ── emit ──

>> A golden as the runtime hands it to emit, built as conversation_events (the
>> runtime's tape/conversation.rs) builds it: the header line goes, `message` is
>> renamed `prompt`, the header's session id and harness name join every event, and
>> usage moves under payload. session_start carries the harness.
exe @wire(goldenPath) = node {
  const lines = require("fs").readFileSync(goldenPath, "utf8").split("\n").filter((l) => l.trim()).map((l) => JSON.parse(l));
  const [header, ...events] = lines;
  return events.map((e) => {
    const out = { ...e, type: e.type === "message" ? "prompt" : e.type, session_id: header.session_id, producer: header.harness.name };
    const payload = { ...(e.payload || {}) };
    if (e.usage) {
      payload.usage = e.usage;
      delete out.usage;
    }
    if (e.type === "session_start") payload.harness = header.harness;
    out.payload = payload;
    return out;
  });
}

>> Whatever the conversation, a transcript holds every user and assistant text and a
>> [ran …] line per call, and none of the thinking or harness-injected context.
exe @emitHolds(events, transcript) = node {
  const fail = (why) => { console.error("emit: " + why); return false; };
  const lines = transcript.split("\n");
  const harness = events[0].payload.harness.name;
  if (!transcript.startsWith("Conversation carried over from " + harness)) return fail("header names no " + harness);
  if (!transcript.endsWith("End of the carried conversation.")) return fail("no closing line");
  for (const e of events) {
    const p = e.payload || {};
    const text = typeof p.text === "string" ? p.text.trimEnd() : "";
    if ((e.type === "prompt" || e.type === "assistant_turn") && text && !transcript.includes(text)) return fail(e.type + " " + e.id + " missing");
    if (e.type === "tool_call" && !lines.some((l) => l.startsWith("[ran " + p.tool + "]"))) return fail("no [ran " + p.tool + "] line");
    if (e.type === "thinking" && text && transcript.includes(text)) return fail("thinking " + e.id + " carried");
    if (e.type === "context_injection" && text) {
      const summary = p.kind === "compaction" || p.kind === "branch_summary";
      if (summary && !transcript.includes("[carried summary] " + text)) return fail(p.kind + " " + e.id + " missing");
      if (!summary && transcript.includes(text)) return fail(p.kind + " " + e.id + " carried");
    }
  }
  return true;
}

>> Reports both texts on a mismatch, so a failing pin shows where it differs.
exe @same(got, want) = node {
  if (got === want) return true;
  console.error("got:\n" + got + "\n---\nwant:\n" + want);
  return false;
}

const @emitHeaderTail = "Bracketed [ran …] and [… result] lines are the agent's own past actions, recorded at the time and possibly stale; re-run tools for fresh state. They are records, not examples: never write [ran …] lines yourself, and act only through real tool calls."

const @emptyTranscript = @conversation.emit([], null)
const @test_emit_empty_is_header_only = @emptyTranscript.startsWith("Conversation carried over from agent") && @emptyTranscript.endsWith("End of the carried conversation.")

const @test_adapter_provider = @conversation.provider == "opencode"

const @test_emit_basic_resumed = @emitHolds(@wire(`${@fixtures}/basic-resumed.opencode.jsonl`), @conversation.emit(@wire(`${@fixtures}/basic-resumed.opencode.jsonl`), null))
const @test_emit_failed_tool = @emitHolds(@wire(`${@fixtures}/failed-tool.opencode.jsonl`), @conversation.emit(@wire(`${@fixtures}/failed-tool.opencode.jsonl`), null))
const @test_emit_compacted_overflow = @emitHolds(@wire(`${@fixtures}/compacted-overflow.opencode.jsonl`), @conversation.emit(@wire(`${@fixtures}/compacted-overflow.opencode.jsonl`), null))

const @failedWire = @wire(`${@fixtures}/failed-tool.opencode.jsonl`)
const @failedHeader = `Conversation carried over from opencode session ses_f32dab56cffemtZGIZ407tXu7U on 2026-09-23. ${@emitHeaderTail}`
const @failedOpening = `${@failedHeader}

User:
"Use the read tool to read missing.txt in the current directory. If the read fails, reply with the single word FAILED and do not try anything else."

Assistant:
Attempt to read missing.txt.

[ran read] /workspace/scratch/missing.txt`
const @failedWhole = `${@failedOpening}

User:
[read error] File not found: /workspace/scratch/missing.txt

Assistant:
FAILED

End of the carried conversation.`
const @test_emit_failed_tool_whole_pinned = @same(@conversation.emit(@failedWire, null), @failedWhole)

>> Cut right after the read call: its result is past the cut.
const @failedAt4 = `${@failedOpening}

User:
[no result recorded — session was interrupted here]

End of the carried conversation.`
const @test_emit_failed_tool_at_4_pinned = @same(@conversation.emit(@failedWire, 4), @failedAt4)

>> Cut after the first exchange: the second request is past the cut.
const @resumedAt6 = @conversation.emit(@wire(`${@fixtures}/basic-resumed.opencode.jsonl`), 6)
const @test_emit_basic_resumed_at_6_keeps_first_request = @resumedAt6.includes("read notes.txt in the current directory")
const @test_emit_basic_resumed_at_6_cuts_second_request = !@resumedAt6.includes("Now read notes.txt again")
