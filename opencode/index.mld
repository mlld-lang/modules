needs { sh }

>> ── Stream format adapter for Opencode CLI NDJSON events (opencode run --format json) ──
>>
>> Aligned with @claudeStreamFormat where possible. Opencode fuses tool-use and
>> tool-result into a single `tool_use` event at completion time, so the tool-use
>> kind here carries `result` inline instead of being paired with a separate
>> tool-result event. See modules/claude/index.mld for the claude-shape reference.
const @opencodeStreamFormat = {
  name: "opencode",
  format: "ndjson",
  schemas: [
    {
      kind: "message",
      matchPath: "type",
      matchValue: "text",
      extract: { chunk: "part.text" }
    },
    {
      kind: "thinking",
      matchPath: "type",
      matchValue: "reasoning",
      extract: { text: "part.text" }
    },
    {
      kind: "tool-use",
      matchPath: "type",
      matchValue: "tool_use",
      extract: {
        name: "part.tool",
        id: "part.callID",
        input: "part.state.input",
        result: "part.state.output",
        status: "part.state.status"
      }
    },
    {
      kind: "metadata",
      matchPath: "type",
      matchValue: "step_start",
      extract: { sessionId: "sessionID" }
    },
    {
      kind: "metadata",
      matchPath: "type",
      matchValue: "step_finish",
      extract: {
        inputTokens: "part.tokens.input",
        outputTokens: "part.tokens.output",
        totalTokens: "part.tokens.total",
        reasoningTokens: "part.tokens.reasoning",
        cost: "part.cost",
        reason: "part.reason"
      }
    }
  ]
}

>> ── Session / resume helpers ──

>> Opencode session ids look like `ses_<base36>` and are case-sensitive,
>> so we trim but preserve case.
exe @normalizeOpencodeSessionId(sessionId) = [
  if !@sessionId.isString() [ => null ]
  let @trimmed = @sessionId.trim()
  => @trimmed != "" ? @trimmed : null
]

>> Parses opencode run --format json NDJSON output for session id, final text, and usage.
>> Concatenates every `text` event's `part.text` in order to reconstruct the agent message.
>> JS because mlld parses JSONL at ~4 ms a line (13 s for a 3,000-line run); back to mlld with m-28a3.
exe @parseOpencodeJsonl(raw) = js {
  const result = { sessionId: null, text: "", inputTokens: null, outputTokens: null, totalTokens: null, cost: null };
  if (typeof raw !== "string" || !raw) return result;
  const chunks = [];
  for (const line of raw.split(/\r?\n/)) {
    const trimmed = line.trim();
    if (!trimmed) continue;
    let obj;
    try { obj = JSON.parse(trimmed); } catch { continue; }
    if (!obj || typeof obj !== "object") continue;
    if (!result.sessionId && typeof obj.sessionID === "string") {
      result.sessionId = obj.sessionID;
    }
    if (obj.type === "text" && obj.part && typeof obj.part.text === "string") {
      chunks.push(obj.part.text);
    } else if (obj.type === "step_finish" && obj.part && obj.part.tokens && typeof obj.part.tokens === "object") {
      const t = obj.part.tokens;
      if (typeof t.input === "number") result.inputTokens = t.input;
      if (typeof t.output === "number") result.outputTokens = t.output;
      if (typeof t.total === "number") result.totalTokens = t.total;
      if (typeof obj.part.cost === "number") result.cost = obj.part.cost;
    }
  }
  result.text = chunks.join("");
  return result;
}

>> Prepends a system prompt to the user prompt.
>> Opencode has no per-invocation `--system` flag; agents carry their own prompts
>> and modifying the prompt text is the only per-call hook.
>> Tests are on string-ness, not truthiness: mlld reads "0" and "false" as false.
exe @prependOpencodeSystem(prompt, system) = [
  let @body = @prompt.isString() ? @prompt : ""
  if !(@system.isString() && @system != "") [ => @body ]
  => `${@system}

${@body}`
]

>> When mlld provides an explicit tool surface, target a concrete OpenCode
>> agent so we can bind permission rules to a real agent config.
>> If the caller did not request an agent explicitly, use a dedicated
>> invocation-local agent instead of the built-in `build` agent so the
>> tool surface cannot inherit built-in defaults.
exe @opencodeToolAgentName(requestedAgent) = [
  let @name = @requestedAgent.isString() ? @requestedAgent.trim() : ""
  => @name != "" ? @name : "mlld"
]

>> Build the invocation-local OpenCode `permission` config that denies every
>> tool by default and then re-enables only the mlld-provided surface: the
>> generated MCP servers plus any tools named in the allow list.
>>
>> - `allowedTools` is the runtime CSV from `@mx.llm.allowed` (the same unified
>>   allow list the claude module passes to `--allowedTools`)
>> - `mcpServers` may be an array or CSV of generated MCP server names; each
>>   server name enables `mcp__<server>__*`
exe @opencodePermissionRules(allowedTools, mcpServers) = js {
  const rules = { "*": "deny" };

  const add = (name, value = "allow") => {
    if (typeof name !== "string") return;
    const trimmed = name.trim();
    if (!trimmed) return;
    rules[trimmed] = value;
  };

  const serverNames = Array.isArray(mcpServers)
    ? mcpServers
    : typeof mcpServers === "string"
      ? mcpServers.split(",")
      : [];

  for (const serverName of serverNames) {
    add(`mcp__${serverName}__*`);
  }

  if (typeof allowedTools === "string") {
    for (const toolName of allowedTools.split(",")) {
      add(toolName);
    }
  }

  return rules;
}

>> Reads the public and runtime-injected resume/session config for opencode.
>>
>> Public API:
>>   config.sessionId - explicit conversation tracking id
>>   config.resume    - explicit resume session id
>>
>> Runtime API:
>>   config._mlld.resume = { sessionId, provider, continue }
>>
>> Runtime resume is ignored when the recorded provider is not opencode so a
>> claude/codex session never leaks across providers.
exe @opencodeResume(config) = [
  let @cfg = @config ? @config : {}
  let @runtime = @cfg._mlld ? @cfg._mlld : {}
  let @resume = @runtime.resume ? @runtime.resume : {}
  let @runtimeProvider = @resume.provider ? @resume.provider : "opencode"
  let @runtimeSessionId = @normalizeOpencodeSessionId(@resume.sessionId)
  let @publicSessionId = @normalizeOpencodeSessionId(@cfg.sessionId)
  let @publicResumeId = @normalizeOpencodeSessionId(@cfg.resume)
  => match [
    @resume.continue && @runtimeSessionId && @runtimeProvider == "opencode" => {
      continue: true,
      sessionId: @runtimeSessionId,
      provider: "opencode",
      source: "runtime_resume"
    }
    @publicResumeId => {
      continue: true,
      sessionId: @publicResumeId,
      provider: "opencode",
      source: "public_resume"
    }
    @runtimeSessionId && @runtimeProvider == "opencode" => {
      continue: false,
      sessionId: @runtimeSessionId,
      provider: "opencode",
      source: "runtime_tracking"
    }
    @publicSessionId => {
      continue: false,
      sessionId: @publicSessionId,
      provider: "opencode",
      source: "public_session"
    }
    * => {
      continue: false,
      sessionId: null,
      provider: "opencode",
      source: "none"
    }
  ]
]

>> Wraps the result with a runtime-visible `_mlld` envelope so the interpreter
>> can harvest the session id and provider across guard-driven resume.
exe @opencodeResult(inputValue, resume) = match [
  @resume.sessionId => {
    value: @inputValue,
    _mlld: {
      sessionId: @resume.sessionId,
      provider: @resume.provider
    }
  }
  * => @inputValue
]

>> ── MCP bridge translation ──
>>
>> The runtime-generated MCP config at @mx.llm.config is a Claude-format JSON
>> `{ mcpServers: { name: { command, args, env, url } } }`. Opencode consumes MCP
>> servers via its `opencode.json` config under a top-level `mcp` key with shape:
>>
>>   { "mcp": { "name": { "type": "local", "command": ["node", "..."], "environment": {...} } } }
>>
>> OpenCode supports inline runtime overrides through OPENCODE_CONFIG_CONTENT.
>> We use that as the invocation-local carrier for generated MCP servers plus
>> the explicit tool surface for this call. This lands after global/project
>> config merge, so the generated tool surface wins over ambient user defaults.
exe @opencodeInlineConfig(configPath, allowedTools, requestedAgent, hasToolSurface, mcpTimeoutMs) = node {
  const fs = require('fs');
  const explicitToolSurface = hasToolSurface === true || hasToolSurface === 'true' || hasToolSurface === 1;

  // `allowedTools` is the unified CSV from @mx.llm.allowed — the same allow list
  // the claude module passes to --allowedTools. It carries the selected native
  // tools plus mcp__* entries. The deny-by-default base below is OpenCode's
  // equivalent of claude's --disallowedTools: everything not named here stays
  // denied, so listing no native tools (e.g. an MCP-only surface) leaves every
  // native tool denied.
  //
  // mlld's capitalized VFS builtin names (Read/Write/Bash/Glob/Grep) are mapped
  // to their OpenCode equivalents so a provider-agnostic tool surface re-enables
  // the right native tools; Write maps to the whole file mutation family
  // (write/edit/patch/apply_patch). Lowercase OpenCode native names ("edit",
  // "bash", ...) and mcp__* entries pass through unchanged.
  const NATIVE_ALIASES = {
    Read: ['read'],
    Write: ['write', 'edit', 'patch', 'apply_patch'],
    Bash: ['bash'],
    Glob: ['glob', 'list'],
    Grep: ['grep']
  };
  const allowedNames = (typeof allowedTools === 'string' ? allowedTools.split(',') : [])
    .map((item) => item.trim())
    .filter(Boolean);
  const allowNames = allowedNames.flatMap((name) => NATIVE_ALIASES[name] || [name]);

  // mcpTimeoutMs is optional. If a positive integer is provided, emit
  // experimental.mcp_timeout. Otherwise omit entirely and let opencode
  // use its built-in default — that way we never silently override
  // opencode's default with an arbitrary number.
  const timeoutMs = (() => {
    if (typeof mcpTimeoutMs === 'number' && mcpTimeoutMs > 0 && Number.isFinite(mcpTimeoutMs)) return Math.floor(mcpTimeoutMs);
    if (typeof mcpTimeoutMs === 'string' && /^\d+$/.test(mcpTimeoutMs.trim())) {
      const n = parseInt(mcpTimeoutMs.trim(), 10);
      if (n > 0) return n;
    }
    return null;
  })();

  let parsed = null;
  if (configPath && fs.existsSync(configPath)) {
    try { parsed = JSON.parse(fs.readFileSync(configPath, 'utf8')); } catch { parsed = null; }
  }

  const translated = {};
  const servers = parsed && parsed.mcpServers;
  if (servers && typeof servers === 'object') {
    for (const [name, spec] of Object.entries(servers)) {
      if (!spec || typeof spec !== 'object') continue;
      if (!/^[A-Za-z_][A-Za-z0-9_-]*$/.test(name)) continue;
      if (typeof spec.url === 'string') {
        const headers = {};
        if (spec.headers && typeof spec.headers === 'object') {
          for (const [k, v] of Object.entries(spec.headers)) {
            if (typeof v === 'string') headers[k] = v;
          }
        }
        translated[name] = { type: 'remote', url: spec.url, headers };
        continue;
      }
      if (typeof spec.command !== 'string') continue;
      const argv = [spec.command];
      if (Array.isArray(spec.args)) {
        for (const a of spec.args) argv.push(String(a));
      }
      const environment = {};
      if (spec.env && typeof spec.env === 'object') {
        for (const [k, v] of Object.entries(spec.env)) {
          if (typeof v === 'string') environment[k] = v;
        }
      }
      translated[name] = { type: 'local', command: argv, environment, enabled: true };
    }
  }

  const translatedNames = Object.keys(translated);
  if (!translatedNames.length && !allowedNames.length && !explicitToolSurface) return "";

  const base = { $schema: 'https://opencode.ai/config.json' };
  if (timeoutMs !== null) {
    base.experimental = { mcp_timeout: timeoutMs };
  }
  if (translatedNames.length) {
    base.mcp = translated;
  }

  if (allowedNames.length || translatedNames.length || explicitToolSurface) {
    const agentName = typeof requestedAgent === 'string' && requestedAgent.trim()
      ? requestedAgent.trim()
      : 'mlld';
    const permissionRules = { '*': 'deny' };
    const toolRules = { '*': false };
    for (const name of translatedNames) {
      permissionRules[`${name}_*`] = 'allow';
      toolRules[`${name}_*`] = true;
    }
    for (const name of allowNames) {
      permissionRules[name] = 'allow';
      toolRules[name] = true;
    }
    base.agent = {
      [agentName]: {
        permission: permissionRules,
        tools: toolRules
      }
    };
  }

  return JSON.stringify(base);
}

>> ── Shell wrapper for opencode run ──
>>
>> Flat positional params so BashExecutor injects each one as a distinct env var.
>> Routing through sh {} with env vars sidesteps the mlld cmd-block double-escape
>> bug for interpolated values (see ticket m-8694).
>> opencodeBin is last so tests can point it at a stub; empty runs `opencode` from PATH.
exe @runOpencodeSh(prompt, dir, model, agent, variant, bypass, inlineConfig, doResume, resumeId, dataHome, stateHome, pure, escapePrompt, opencodeBin) = sh {
  set -e

  if [ -n "$dataHome" ]; then
    export XDG_DATA_HOME="$dataHome"
  fi

  if [ -n "$stateHome" ]; then
    export XDG_STATE_HOME="$stateHome"
  fi

  if [ -n "$inlineConfig" ]; then
    export OPENCODE_CONFIG_CONTENT="$inlineConfig"
  fi

  dirFlag=()
  if [ -n "$dir" ]; then
    dirFlag=(--dir "$dir")
  fi

  modelFlag=()
  if [ -n "$model" ]; then
    modelFlag=(-m "$model")
  fi

  agentFlag=()
  if [ -n "$agent" ]; then
    agentFlag=(--agent "$agent")
  fi

  variantFlag=()
  if [ -n "$variant" ]; then
    variantFlag=(--variant "$variant")
  fi

  bypassFlag=()
  if [ -n "$bypass" ]; then
    bypassFlag=(--dangerously-skip-permissions)
  fi

  pureFlag=()
  if [ -n "$pure" ]; then
    pureFlag=(--pure)
  fi

  sessionFlag=()
  if [ -n "$doResume" ]; then
    sessionFlag=(-s "$resumeId")
  fi

  promptArg="$prompt"
  if [ -n "$escapePrompt" ]; then
    promptArg=$(printf '%s' "$prompt" | perl -0pe 's/\r//g; s/\n+/ /g')
  fi

  "${opencodeBin:-opencode}" run "${pureFlag[@]}" --format json "${dirFlag[@]}" "${modelFlag[@]}" "${agentFlag[@]}" "${variantFlag[@]}" "${bypassFlag[@]}" "${sessionFlag[@]}" "$promptArg"
}

>> ── Core invocation ──
>>
>> @opencode(prompt, config)
>> config.model     - provider/model string, e.g. "anthropic/claude-sonnet-4-5"
>> config.dir       - working directory (passed via --dir)
>> config.opencodeBin - the opencode executable to run (default: opencode on PATH)
>> config.agent     - opencode agent name (--agent)
>> config.variant   - reasoning variant: "minimal" | "high" | "max" (--variant)
>> config.bypass    - boolean, passes --dangerously-skip-permissions
>> config.pure      - boolean, passes --pure to skip external plugins
>> config.system    - prepended to the prompt (opencode has no per-call system flag)
>> config.stream    - JSONL streaming via stream adapter
>> config.sessionId - explicit tracking session id
>> config.resume    - explicit resume session id
>> config.dataHome  - optional XDG_DATA_HOME override, useful for isolated
>>                    nested opencode workers that must not share the parent
>>                    process's active sqlite database
>> config.stateHome - optional XDG_STATE_HOME override for isolated locks/state
>> config.tools     - mlld convention: runtime populates @mx.llm.config with a
>>                    generated MCP bridge JSON. We translate it into an
>>                    opencode.json mcp block and expose via XDG_CONFIG_HOME.
>>                    When tools are present, the module also applies an
>>                    invocation-local OpenCode agent permission block that
>>                    denies every tool by default and re-enables only the
>>                    requested surface: the generated MCP servers plus any
>>                    OpenCode native tools the caller listed as plain strings
>>                    (e.g. "edit", "bash", or the mlld VFS names Read/Write/
>>                    Bash/Glob/Grep). List no native tools to keep the surface
>>                    MCP-only.
>>
>> Runtime notes:
>> - Always runs `opencode run --format json` so we can parse sessionID + text
>>   + usage regardless of streaming mode. In stream mode the stream adapter
>>   consumes `text` events as they arrive; @raw still holds the full NDJSON.
>> - Uses a `sh { }` block so interpolated values flow as bash env vars and
>>   survive unescaped (see ticket m-8694 for the `cmd` block escaping bug).
llm @opencode(prompt, config) with { stream: @config.stream, stream_format: @opencodeStreamFormat } = [
  let @cfg = @config ? @config : {}
  let @dir = @cfg.dir ? @cfg.dir : @root
  let @model = @cfg.model ? @cfg.model : "openrouter/z-ai/glm-5.1"
  let @requestedAgent = @cfg.agent ? @cfg.agent : ""
  let @variant = @cfg.variant ? @cfg.variant : ""
  let @bypass = @cfg.bypass ? "1" : ""
  >> Any engagement with the tool system locks the surface down: when the runtime
  >> set @mx.llm.hasTools (a `tools` key was passed, including an empty `tools: []`)
  >> we always emit the deny-by-default permission block, so OpenCode's native
  >> tools are disabled unless explicitly re-enabled via the allow list. An omitted
  >> `tools` leaves hasTools false and OpenCode keeps its native defaults. The block
  >> is emitted even when the allow list is empty — @opencodeInlineConfig returns a
  >> pure `{ '*': 'deny' }` surface in that case.
  let @hasToolBridge = @mx.llm && @mx.llm.hasTools
  let @mcpTimeoutMs = @cfg.mcpTimeoutMs.isDefined() ? @cfg.mcpTimeoutMs : null
  let @inlineConfig = match [
    @hasToolBridge => @opencodeInlineConfig(@mx.llm.config ?? "", @mx.llm.allowed ?? "", @requestedAgent, true, @mcpTimeoutMs)
    * => ""
  ]
  let @agent = match [
    @inlineConfig && @hasToolBridge => @opencodeToolAgentName(@requestedAgent)
    * => @requestedAgent
  ]
  let @finalPrompt = @cfg.system.isString() && @cfg.system != "" ? @prependOpencodeSystem(@prompt, @cfg.system) : @prompt
  let @resume = @opencodeResume(@cfg)
  let @doResume = @resume.continue && @resume.sessionId ? "1" : ""
  let @resumeId = @resume.sessionId ? @resume.sessionId : ""
  let @dataHome = @cfg.dataHome ? @cfg.dataHome : ""
  let @stateHome = @cfg.stateHome ? @cfg.stateHome : ""
  let @pure = @cfg.pure ? "1" : ""
  let @escapePrompt = @hasToolBridge ? "" : "1"
  let @raw = @runOpencodeSh(@finalPrompt, @dir, @model, @agent, @variant, @bypass, @inlineConfig, @doResume, @resumeId, @dataHome, @stateHome, @pure, @escapePrompt, @cfg.opencodeBin ?? "")
  let @parsed = @parseOpencodeJsonl(@raw)
  let @sessionId = @normalizeOpencodeSessionId(@parsed.sessionId ?? @resume.sessionId ?? null)
  let @value = match [
    @cfg.stream => @raw
    @parsed.text != "" => @parsed.text
    * => @raw
  ]
  => @opencodeResult(@value, {
    sessionId: @sessionId,
    provider: "opencode",
    source: @resume.source
  })
]

>> ── Conversation adapter ──
>> Finds a stored opencode session and translates it into IFT events (the tape's
>> event format), in the same envelope as the claude, codex and pi adapters. fray
>> has no opencode ingester, so the mapping is this module's own; the goldens in
>> tests/fixtures/conversation pin it.

>> @conversation.locate(sessionId, cwd, storeRoot?, bin?) → absolute path, or null
>> opencode keeps sessions in a private sqlite schema, so this goes through the
>> public `opencode export <id>` and snapshots its JSON to a temp file the caller
>> owns. storeRoot is the XDG_DATA_HOME the session ran under (config.dataHome). cwd is
>> ignored; it keeps the signature shared with the other harnesses. bin replaces
>> the opencode binary, for tests.
exe @conversationLocate(sessionId, cwd, storeRoot, bin) = node {
  const fs = require("fs");
  const os = require("os");
  const path = require("path");
  const { execFileSync } = require("child_process");
  // The id reaches argv, so this pattern is also what keeps it from being read as
  // a flag or a path. opencode ids are case-sensitive: no normalising.
  if (typeof sessionId !== "string" || !/^ses_[A-Za-z0-9]+$/.test(sessionId)) return null;
  const env = { ...process.env };
  if (typeof storeRoot === "string" && storeRoot) env.XDG_DATA_HOME = storeRoot;
  const exe = typeof bin === "string" && bin ? bin : "opencode";
  let out;
  try {
    out = execFileSync(exe, ["export", sessionId], { env, timeout: 30000, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], maxBuffer: 256 * 1024 * 1024 });
  } catch (e) { return null; }
  let parsed;
  try { parsed = JSON.parse(out); } catch (e) { return null; }
  if (!parsed || typeof parsed !== "object" || !parsed.info || parsed.info.id !== sessionId) return null;
  try {
    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "mlld-opencode-"));
    const file = path.join(dir, sessionId + ".json");
    fs.writeFileSync(file, out);
    return path.resolve(file);
  } catch (e) { return null; }
}

>> @conversation.ingest(text) → { header, events }
>> text is the JSON of an `opencode export`. Reads no files.
>> Throws when text is not a string or is not JSON.
exe @conversationIngest(text) = node {
  const fs = require("fs");
  const crypto = require("crypto");
  if (typeof text !== "string") {
    throw new TypeError("@mlld/opencode conversation.ingest: expected the log's text as a string; load the file with <path> and pass .mx.text");
  }
  const data = JSON.parse(text);
  const isObj = (v) => v !== null && typeof v === "object" && !Array.isArray(v);
  const str = (v) => (typeof v === "string" ? v : "");
  const num = (v) => (typeof v === "number" && isFinite(v) ? v : 0);
  const info = isObj(data) && isObj(data.info) ? data.info : {};
  const messages = (isObj(data) && Array.isArray(data.messages) ? data.messages : [])
    .filter(isObj)
    .map((m) => ({ info: isObj(m.info) ? m.info : {}, parts: Array.isArray(m.parts) ? m.parts.filter(isObj) : [] }));

  // Go's time.RFC3339Nano in UTC: the fraction loses trailing zeros, and its dot
  // when nothing is left.
  const ZERO = "0001-01-01T00:00:00Z";
  const formatTS = (ms) => {
    if (typeof ms !== "number" || !isFinite(ms)) return ZERO;
    const d = new Date(ms);
    if (isNaN(d.getTime())) return ZERO;
    return d.toISOString().replace(/\.(\d*?)0*Z$/, (_, f) => (f ? "." + f : "") + "Z");
  };
  const created = (m) => formatTS(isObj(m.info.time) ? m.info.time.created : undefined);

  const sessionID = str(info.id);
  let cwd = str(info.directory);
  if (cwd) {
    try { cwd = fs.realpathSync(cwd); } catch (e) {}
  }
  const startedAt = formatTS(isObj(info.time) ? info.time.created : undefined);
  const harness = { name: "opencode" };
  if (str(info.version)) harness.version = info.version;

  if (isObj(info.revert)) {
    console.error("@mlld/opencode conversation.ingest: session has a pending revert; ingesting every message");
  }

  const events = [];
  const taken = new Set();
  const append = (ev) => {
    const seq = events.length;
    let id;
    for (let nonce = 0; ; nonce++) {
      id = crypto.createHash("sha256").update(sessionID + "\x00" + seq + "\x00" + nonce).digest("hex").slice(0, 8);
      if (!taken.has(id)) break;
    }
    taken.add(id);
    const out = { id };
    if (ev.parent_id) out.parent_id = ev.parent_id;
    out.seq = seq;
    out.ts = ev.ts;
    out.type = ev.type;
    if (ev.usage) out.usage = ev.usage;
    if (ev.payload) out.payload = ev.payload;
    events.push(out);
    return out;
  };
  let prev = append({ ts: startedAt, type: "session_start" });
  const chain = (ev) => { prev = append({ ...ev, parent_id: prev.id }); return prev; };

  const texts = (parts) => parts.filter((p) => p.type === "text").map((p) => str(p.text)).join("");
  const isSummary = (m) => m.info.role === "assistant" && m.info.summary === true;

  // Tip view: the model holds the last compaction's summary, not what came before it.
  let start = 0;
  let lastCompaction = -1;
  messages.forEach((m, i) => { if (m.parts.some((p) => p.type === "compaction")) lastCompaction = i; });
  if (lastCompaction >= 0) {
    let summary = -1;
    for (let i = lastCompaction + 1; i < messages.length; i++) {
      if (isSummary(messages[i])) { summary = i; break; }
    }
    const at = summary >= 0 ? messages[summary] : messages[lastCompaction];
    chain({ ts: created(at), type: "context_injection", payload: { source: "opencode", kind: "compaction", text: summary >= 0 ? texts(at.parts) : "" } });
    start = (summary >= 0 ? summary : lastCompaction) + 1;
  }

  const SKIPPED = new Set(["text", "reasoning", "tool", "compaction", "step-start", "step-finish", "snapshot", "patch", "file", "agent", "subtask"]);
  const warned = new Set();

  for (let i = start; i < messages.length; i++) {
    const m = messages[i];
    const ts = created(m);
    for (const p of m.parts) {
      const t = str(p.type);
      if (!SKIPPED.has(t) && !warned.has(t)) {
        warned.add(t);
        console.error("@mlld/opencode conversation.ingest: skipping unknown part type " + JSON.stringify(t));
      }
    }
    if (m.info.role === "user") {
      const text = m.parts.filter((p) => p.type === "text" && p.synthetic !== true).map((p) => str(p.text)).join("");
      if (text) chain({ ts, type: "message", payload: { role: "user", text } });
      for (const p of m.parts) {
        if (p.type === "text" && p.synthetic === true) {
          chain({ ts, type: "context_injection", payload: { source: "opencode", kind: "synthetic", text: str(p.text) } });
        }
      }
      continue;
    }
    if (m.info.role !== "assistant" || isSummary(m)) continue;

    // A provider error leaves an assistant message with no parts; it emits nothing.
    const content = m.parts.filter((p) => p.type === "text" || p.type === "tool" || (p.type === "reasoning" && str(p.text)));
    if (content.length === 0) continue;
    const tools = m.parts.filter((p) => p.type === "tool");
    const payload = {};
    if (str(m.info.providerID)) payload.provider = m.info.providerID;
    if (str(m.info.modelID)) payload.model = m.info.modelID;
    const text = texts(m.parts);
    if (text) payload.text = text;
    if (tools.length) payload.tool_use_ids = tools.map((p) => str(p.callID));
    if (str(m.info.finish)) payload.stop_reason = m.info.finish;
    const turnEv = { ts, type: "assistant_turn", payload };
    // opencode counts reasoning outside output; IFT's thinking is a share of output.
    const tk = m.info.tokens;
    if (isObj(tk)) {
      const cache = isObj(tk.cache) ? tk.cache : {};
      const usage = { input: num(tk.input), output: num(tk.output) + num(tk.reasoning) };
      if (num(cache.read)) usage.cache_read = num(cache.read);
      if (num(cache.write)) usage.cache_write = num(cache.write);
      if (num(tk.reasoning)) usage.thinking = num(tk.reasoning);
      turnEv.usage = usage;
    }
    const turn = chain(turnEv);

    let lastCall = null;
    for (const p of m.parts) {
      if (p.type === "reasoning" && str(p.text)) {
        prev = append({ parent_id: turn.id, ts, type: "thinking", payload: { text: p.text } });
      } else if (p.type === "tool") {
        const call = { tool: str(p.tool) };
        const input = isObj(p.state) ? p.state.input : undefined;
        if (input !== undefined && input !== null) call.args = input;
        if (str(p.callID)) call.tool_use_id = p.callID;
        prev = lastCall = append({ parent_id: turn.id, ts, type: "tool_call", payload: call });
      }
    }
    // Results chain from the last call, one after another, as claude's do. The last
    // call and not the last child, because a reasoning part can follow it.
    let resultParent = lastCall;
    const result = (payload) => { prev = resultParent = append({ parent_id: resultParent.id, ts, type: "tool_result", payload }); };
    for (const p of tools) {
      const st = isObj(p.state) ? p.state : {};
      if (st.status === "completed") {
        result({ tool_use_id: str(p.callID), content: str(st.output) });
      } else if (st.status === "error") {
        result({ tool_use_id: str(p.callID), content: str(st.error), is_error: true });
      }
    }
  }

  return { header: { type: "session", session_id: sessionID, harness, cwd, started_at: startedAt }, events };
}

const @conversation = { locate: @conversationLocate, ingest: @conversationIngest }

export { @opencode, @opencodeStreamFormat, @opencodeToolAgentName, @opencodePermissionRules, @conversation, @parseOpencodeJsonl, @prependOpencodeSystem, @normalizeOpencodeSessionId }
