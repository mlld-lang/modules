>> @mlld/shelf — record workspaces on core state.
>>
>> A shelf is a state built from records (`state @st from @recs`), one slot per record
>> family. These exports find stored records by address and resolve `{ref}` citations to
>> the field values they name, with the values' labels and proof intact.
>>
>> Written in mlld only: a value that crosses into a js block loses its proof labels, and
>> keeping proof is what makes a resolved value usable in a grant.
>>
>> No exe carries a role label, so every state operation runs as the caller's role.
>>
>> Every export takes untrusted input (an address or ref an agent wrote) and answers null or
>> false for anything malformed rather than throwing.

>> ── Addresses ──

>> The record family of an address: the text before the first `:`. Null for anything that
>> is not a string with a non-empty family, so callers default to deny.
exe @familyOf(address) = [
  if !@address.isString() [ => null ]
  let @i = @address.indexOf(":")
  if @i < 1 [ => null ]
  => @address.slice(0, @i)
]

>> The families a shelf holds: its record slots. A plain state can also have ordinary
>> slots (`label: string?`), whose `.mx.version` reads null. Exports with a `families`
>> parameter call `@slotNames` because the parameter shadows `@families` inside them.
exe @slotNames(st) = [
  if @typeof(@st) != "object" [ => [] ]
  => for @k, @slot in @st if @st[@k].mx.version != null => @k
]
exe @families(st) = @slotNames(@st)

>> The families a caller may resolve: the given list, or every slot of the shelf when the
>> caller passes something that is not a list.
exe @allowedFamilies(st, families) = [
  => match [ @typeof(@families) == "array" => @families; * => @slotNames(@st) ]
]

>> The stored record at an address, or null. The family must be both allowed and a slot of
>> the shelf: asking the state for a slot it lacks is an error, not a miss.
exe @find(st, address, families = null) = [
  let @family = @familyOf(@address)
  if @family == null [ => null ]
  if !@allowedFamilies(@st, @families).includes(@family) [ => null ]
  if !@slotNames(@st).includes(@family) [ => null ]
  let @rec = @st.byAddress(@family, @address)
  => match [ @rec.isDefined() => @rec; * => null ]
]

>> ── {ref} citations ──

>> True exactly for `{ ref: { address: <string>, field: <string> } }`.
exe @isRef(v) = [
  if @typeof(@v) != "object" [ => false ]
  let @ref = @v.ref
  if @typeof(@ref) != "object" [ => false ]
  => @ref.address.isString() && @ref.field.isString()
]

>> Whether `field` is one of the record's own fields, so a cited field name can never reach
>> the record's metadata (`mx`) or a method.
exe @hasField(rec, field) = [
  let @names = for @k, @v in @rec => @k
  => @names.includes(@field)
]

>> The field value a ref cites, or null. Returned straight from the record so its labels
>> and proof come with it.
exe @resolveRef(refObj, st, families = null) = [
  if !@isRef(@refObj) [ => null ]
  let @rec = @find(@st, @refObj.ref.address, @families)
  if @rec == null [ => null ]
  if !@hasField(@rec, @refObj.ref.field) [ => null ]
  => @rec[@refObj.ref.field]
]

>> The first arg whose value is a ref that does not resolve, as `{ arg, addr }`, so a caller
>> can deny with the address in hand instead of a bare grant refusal. Null when every ref
>> resolves.
exe @unresolvedArg(name, value, st, families = null) = [
  if !@isRef(@value) [ => null ]
  if @resolveRef(@value, @st, @families) != null [ => null ]
  => { arg: @name, addr: @value.ref.address }
]

exe @firstUnresolved(args, st, families = null) = [
  if @typeof(@args) != "object" [ => null ]
  let @misses = for @name, @value in @args => @unresolvedArg(@name, @value, @st, @families)
  let @hits = for @m in @misses if @m != null => @m
  => match [ @hits.length > 0 => @hits[0]; * => null ]
]

>> ── Writes ──
>>
>> Writes go through the state the caller passes, as the caller's role: core checks the
>> record's write grant against that role and ends the run on a refusal.

>> Structural equality: same type, scalars `==`, arrays element by element in order,
>> objects with the same keys and equal values.
exe @same(a, b) = [
  let @ta = @typeof(@a)
  if @ta != @typeof(@b) [ => false ]
  if @ta == "array" [
    if @a.length != @b.length [ => false ]
    let @diffs = for @x in @a if !@same(@x, @b[@x.mx.index]) => 1
    => @diffs.length == 0
  ]
  if @ta == "object" [
    let @ka = for @k, @v in @a => @k
    let @kb = for @k, @v in @b => @k
    if @ka.length != @kb.length [ => false ]
    let @diffs = for @k, @v in @a if !@kb.includes(@k) || !@same(@v, @b[@k]) => 1
    => @diffs.length == 0
  ]
  => @a == @b
]

>> The address a record would be stored at, or null for anything that is not a record.
exe @addressOf(record) = [
  if @typeof(@record) != "object" [ => null ]
  let @addr = @record.mx.address
  if @typeof(@addr) != "object" [ => null ]
  => match [ @addr.string.isString() => @addr.string; * => null ]
]

>> True when writing `record` would change what the shelf holds: nothing is stored at its
>> address, or one of its non-null fields is missing from the stored record or differs.
exe @addsData(st, record) = [
  let @address = @addressOf(@record)
  if @address == null [ => false ]
  let @stored = @find(@st, @address)
  if @stored == null [ => true ]
  let @storedFields = for @k, @v in @stored => @k
  let @news = for @k, @v in @record if @v != null && (!@storedFields.includes(@k) || !@same(@v, @stored[@k])) => @k
  => @news.length > 0
]

>> Files one record into the slot for its family. The slot's merge mode decides between
>> replacing a stored record with the same key and appending.
exe @put(st, record, families = null) = [
  let @address = @addressOf(@record)
  let @family = @familyOf(@address)
  let @slots = @slotNames(@st)
  let @ok = @family != null && @slots.includes(@family) && @allowedFamilies(@st, @families).includes(@family)
  if !@ok [ => { address: @address, family: @family, written: false, redundant: false } ]
  let @redundant = !@addsData(@st, @record)
  let @w = @st.upsert(@family, @record)
  => { address: @address, family: @family, written: true, redundant: @redundant }
]

>> `@put` over a list of records, or one record.
exe @observe(st, records, families = null) = [
  let @list = match [ @typeof(@records) == "array" => @records; * => ([@records]) ]
  let @results = for @r in @list => @put(@st, @r, @families)
  let @done = for @r in @results if @r.written => @r
  let @fresh = for @r in @done if !@r.redundant => @r
  let @addresses = for @r in @done => @r.address
  => { addresses: @addresses, written: @done.length, redundant: @done.length > 0 && @fresh.length == 0 }
]

>> ── Rendering ──
>>
>> `@render` shows only the view of the role active where it is called. It takes no role
>> argument: `@project(@rec, <role>)` would answer another role's view, and the rendered
>> string carries nothing that would re-project it, so a role argument would let a caller
>> widen its own view.

>> The active role's read modes for one record type, `{ field: mode }`. `@mx.actors` holds
>> the current actor only, and drops `omit` fields.
exe @readModes(recordName) = [
  let @maps = for @role, @actor in @mx.actors => @actor.records[@recordName]
  let @found = for @m in @maps if @typeof(@m) == "object" => @m
  => match [ @found.length > 0 => @found[0]; * => {} ]
]

>> The entries of one slot. Each record's entry is built inside the loop, with no exe call per
>> record: passing a value read from a state into an exe costs time that grows with the
>> size of the state, which made rendering a large shelf quadratic.
>>
>> Fields the role may see go in `fields`; fields it may cite but not see (`mask`, `handle`,
>> `protected`) are named in `ref_fields`. With a role active, its read modes decide, and
>> values are taken from the projection only for `bare`/`value` fields. With none,
>> `@mx.actors` is empty and the projection follows the record's `*` rule: its plain values
>> are shown and its `{ preview, handle }` / `{ handle }` wrappers named. A wrapper never
>> reaches the output either way.
exe @slotLines(st, slot) = [
  let @stored = @st[@slot]
  if @stored.length == 0 [ => [] ]
  >> A slot can hold records of more than one type, and each type has its own read rules.
  let @names = for @rec in @stored => @rec.mx.address.record
  let @types = for @t in @names if @names.indexOf(@t) == @t.mx.index => @t
  let @modesByType = for @t in @types => { [@t]: @readModes(@t) }
  => for @rec in @stored [
    let @modes = @modesByType[@rec.mx.address.record]
    let @hasModes = @modes.mx.keys.length > 0
    let @view = @project(@rec)
    let @wrapped = for @f, @v in @view if @typeof(@v) == "object" && @v.mx.keys.includes("handle") && @v.mx.keys.every(@item == "handle" || @item == "preview") => @f
    let @shown = match [
      @hasModes => for @f, @mode in @modes if @mode == "bare" || @mode == "value" => @f;
      * => for @f, @v in @view if !@wrapped.includes(@f) => @f
    ]
    let @cited = match [
      @hasModes => for @f, @mode in @modes if @mode == "mask" || @mode == "handle" || @mode == "protected" => @f;
      * => @wrapped
    ]
    >> A `for` yielding `{ [key]: value }` collects into one object; with no keys it yields `[]`.
    let @picked = for @f in @shown => { [@f]: @view[@f] }
    let @fields = match [ @shown.length > 0 => @picked; * => {} ]
    => { address: @rec.mx.address.string, fields: @fields, ref_fields: @cited }
  ]
]

>> Every record stored in `families` (default: all slots), one JSON line each, in slot
>> order then storage order, inside `<observed>` tags; "" when there are none.
exe @render(st, families = null) = [
  let @allowed = @allowedFamilies(@st, @families)
  let @slots = for @f in @slotNames(@st) if @allowed.includes(@f) => @f
  let @groups = for @f in @slots => @slotLines(@st, @f)
  let @entries = @groups.flat()
  if @entries.length == 0 [ => "" ]
  >> A template loop writes each entry as compact JSON on its own line. It also leaves a
  >> blank line after the last one, which `.trim()` drops; every entry ends in `}`.
  let @body = `
/for @e in @entries
${@e}
/end
`
  >> Every `<` is written as its JSON escape, so a stored value cannot close the
  >> `<observed>` block. JSON has `<` only inside strings, where the escape means the same.
  let @lines = @body.trim()
  => `<observed>
${@lines.replaceAll("<", "\\u003c")}
</observed>`
]

>> ── Versions ──
>>
>> Core counts every applied write to a state slot in `<slot>.mx.version`, so the module
>> only reads it. Versions count writes, not changes: an identical `upsert` bumps it.

>> A slot's write count (0 if never written), or null for a family the shelf lacks.
exe @version(st, family) = [
  if !@slotNames(@st).includes(@family) [ => null ]
  => @st[@family].mx.version
]

>> `{ <family>: <version> }` for each family of the shelf in `families` (default: all).
exe @versions(st, families = null) = [
  let @allowed = @allowedFamilies(@st, @families)
  let @present = for @f in @slotNames(@st) if @allowed.includes(@f) => @f
  >> A `for` yielding `{ [key]: value }` collects into one object; with no keys it yields `[]`.
  let @counts = for @f in @present => { [@f]: @st[@f].mx.version }
  => match [ @present.length > 0 => @counts; * => {} ]
]

>> The families in `families` (default: all) written since `snapshot`, a `@versions`
>> result. A family missing from the snapshot, or not counted as a number there, counts as 0.
exe @changedSince(st, snapshot, families = null) = [
  let @before = match [ @typeof(@snapshot) == "object" => @snapshot; * => {} ]
  let @current = @versions(@st, @families)
  => for @f, @v in @current if @v > match [ @typeof(@before[@f]) == "number" => @before[@f]; * => 0 ] => @f
]

export { @familyOf, @families, @find, @isRef, @resolveRef, @firstUnresolved, @addsData, @put, @observe, @render, @version, @versions, @changedSince }
