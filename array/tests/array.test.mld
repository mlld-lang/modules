>> Tests for @mlld/array, ported from the old llm/tests/array.test.mld cases for
>> the functions kept here, plus an empty-input case for each.
>> Run: mlld test array/tests/

import { @unique, @groupBy, @sortBy, @sum, @avg, @range, @chunk, @zip } from "../index.mld"

const @items = [
  { name: "apple", price: 1.50, category: "fruit" },
  { name: "banana", price: 0.75, category: "fruit" },
  { name: "carrot", price: 2.00, category: "vegetable" }
]
const @numbers = [1, 2, 3, 4, 5]

>> ── unique ──
const @test_unique_removes_duplicates = @unique(["a", "b", "a", "c", "b", "d"]).join(",") == "a,b,c,d"
const @test_unique_numbers = @unique([1, 2, 3, 2, 4, 3, 5]).join(",") == "1,2,3,4,5"
const @test_unique_empty = @unique([]).length == 0
const @test_unique_not_array = @unique(null).length == 0

>> ── groupBy ──
const @grouped = @groupBy(@items, "category")
const @test_groupBy_keys = @grouped.mx.keys.join(",") == "fruit,vegetable"
const @test_groupBy_fruit_count = @grouped.fruit.length == 2
const @test_groupBy_vegetable_count = @grouped.vegetable.length == 1
const @test_groupBy_keeps_order = @grouped.fruit[1].name == "banana"
const @test_groupBy_number_keys_become_text = @groupBy([{ n: 1 }, { n: 1 }, { n: 2 }], "n")["1"].length == 2
const @test_groupBy_empty = @groupBy([], "category").mx.keys.length == 0

>> ── sortBy ──
const @byPrice = @sortBy(@items, "price")
const @test_sortBy_ascending = @byPrice.map(@item.name).join(",") == "banana,apple,carrot"
const @test_sortBy_leaves_input = @items[0].name == "apple"
const @test_sortBy_text = @sortBy([{ n: "b" }, { n: "a" }], "n")[0].n == "a"
const @test_sortBy_empty = @sortBy([], "price").length == 0

>> ── sum ──
const @test_sum_prices = @sum(@items, "price") == 4.25
const @test_sum_numbers = @sum(@numbers) == 15
const @test_sum_numeric_text = @sum(["2", "3"]) == 5
const @test_sum_empty = @sum([]) == 0

>> ── avg ──
const @priceMean = @avg(@items, "price")
const @test_avg_prices = @priceMean > 1.41 && @priceMean < 1.42
const @test_avg_numbers = @avg(@numbers) == 3
const @test_avg_empty = @avg([]) == 0

>> ── range ──
const @test_range_step = @range(1, 10, 2).join(",") == "1,3,5,7,9"
const @test_range_default_step = @range(0, 4).join(",") == "0,1,2,3"
const @test_range_negative_step = @range(5, 0, -1).join(",") == "5,4,3,2,1"
const @test_range_empty = @range(3, 3).length == 0
const @test_range_backwards_is_empty = @range(5, 0).length == 0

>> ── chunk ──
const @batches = @chunk(@numbers, 2)
const @test_chunk_count = @batches.length == 3
const @test_chunk_last_short = @batches[2].join(",") == "5"
const @test_chunk_first = @batches[0].join(",") == "1,2"
const @test_chunk_zero_size = @chunk(@numbers, 0).length == 0
const @test_chunk_empty = @chunk([], 2).length == 0

>> ── zip ──
const @pairs = @zip(["name", "age"], ["alice", 30])
const @test_zip_pairs = @pairs[0][0] == "name" && @pairs[0][1] == "alice" && @pairs[1][1] == 30
const @test_zip_short_b_pads_null = @zip([1, 2], ["x"])[1][1] == null
const @test_zip_follows_a_length = @zip([1], ["x", "y"]).length == 1
const @test_zip_empty = @zip([], []).length == 0
const @test_zip_not_array = @zip(null, [1]).length == 0
