>> Tests for the arguments @runPiSh gives pi, against a stub pi that prints them.
>> Run: mlld test pi/tests/run.test.mld

import { @runPiSh, @pi } from "../index.mld"

const @fixtures = `${@root}/pi/tests/fixtures/run`
const @stub = `${@fixtures}/pi-stub.sh`
const @workdir = `${@fixtures}/workdir`
const @sid = "3c1f0b52-8e4d-4a7b-9f21-6d5e4c3b2a10"

exe @has(out, line) = js { return out.split("\n").includes(line); }
exe @hasPrefix(out, prefix) = js { return out.split("\n").some(l => l.startsWith(prefix)); }
exe @argsAfter(out, flag) = js {
  const args = out.split("\n").filter(l => l.startsWith("arg=")).map(l => l.slice(4));
  const i = args.indexOf(flag);
  return i < 0 ? "" : args[i + 1];
}
>> Emptied first so the header check sees a file this run wrote.
exe @emptyDir(dir) = sh { rm -rf "$dir"; mkdir -p "$dir"; echo "$dir" }
exe @readFile(path) = sh { cat "$path" }
>> Every session file under an agent dir, one per line.
exe @sessionFiles(agent) = sh { find "$agent/sessions" -type f -name '*.jsonl' | sort }
exe @baseName(path) = js { return path.split("/").pop(); }
>> pi's rule for a cwd's folder name (session-manager.js getDefaultSessionDirPath).
exe @encodeCwd(cwd) = js { return "--" + cwd.replace(/^[/\\]/, "").replace(/[/\\:]/g, "-") + "--"; }
exe @parentName(path) = js { const parts = path.split("/"); return parts[parts.length - 2]; }

>> ── dir ──

const @inDir = @runPiSh("hi", @workdir, "", "", "", "", "", "", "", "", @stub)
const @test_dir_is_pwd = @has(@inDir, `pwd=${@workdir}`)
const @test_dir_not_a_flag = !@hasPrefix(@inDir, "arg=--dir")

const @missingDir = try @runPiSh("hi", `${@fixtures}/nonexistent`, "", "", "", "", "", "", "", "", @stub)
const @test_missing_dir_fails = !@missingDir.ok

>> ── flags ──

const @flagged = @runPiSh("hi", "", "", "", "", "--no-tools --no-context-files", "", "", "", "", @stub)
const @test_flags_reach_pi = @has(@flagged, "arg=--no-context-files")
const @test_flags_word_split = @has(@flagged, "arg=--no-tools")

>> ── session ──

const @unsaved = @runPiSh("hi", "", "", "", "", "", "", "", "", "", @stub)
const @test_no_session_id_means_no_session = @has(@unsaved, "arg=--no-session")

>> A session is saved in pi's own layout: <agent>/sessions/<encoded cwd>/<timestamp>_<id>.jsonl.
const @agentDir = @emptyDir(`${@fixtures}/agent`)
const @saved = @runPiSh("hi", @workdir, "", "", "", "", "", "", @sid, @agentDir, @stub)
const @sessionFile = @sessionFiles(@agentDir).trim()
const @test_one_session_file = @sessionFile != "" && !@sessionFile.includes("\n")
const @test_session_file_passed = @argsAfter(@saved, "--session") == @sessionFile
const @test_session_not_disabled = !@has(@saved, "arg=--no-session")
const @test_session_file_named_by_pi_rule = @baseName(@sessionFile).endsWith(`_${@sid}.jsonl`) && @baseName(@sessionFile).length == 24 + 1 + 36 + 6
const @test_session_dir_is_encoded_cwd = @parentName(@sessionFile) == @encodeCwd(@workdir)
const @header = @readFile(@sessionFile) | @json
const @test_header_id = @header.id == @sid
const @test_header_type = @header.type == "session"
const @test_header_cwd_is_dir = @header.cwd == @workdir

>> The same id again continues the file it already has, from any directory.
const @again = @runPiSh("hi", "", "", "", "", "", "", "", @sid, @agentDir, @stub)
const @test_same_id_same_file = @argsAfter(@again, "--session") == @sessionFile
const @test_same_id_no_second_file = @sessionFiles(@agentDir).trim() == @sessionFile

>> Through @pi with sessions on (the default): the harness profile lets the
>> stub pi append to the session file.
const @piAgent = @emptyDir(`${@fixtures}/pi-agent`)
const @viaPi = @pi("hi", { sessionId: @sid, agentDir: @piAgent, piBin: `${@fixtures}/pi-append-stub.sh` })
const @piSessionFile = @sessionFiles(@piAgent).trim()
const @test_pi_reports_file = @viaPi.trim() == `appended=${@piSessionFile}`
const @test_pi_stub_wrote_session = @readFile(@piSessionFile).includes('"type":"message"')

>> ── system prompt ──

>> The text reaches pi through a file, unchanged, backticks and ${…} included.
const @systemText = "Answer in `code` only, never ${literally}; say \"ok\"."
const @withSystem = @runPiSh("hi", "", "", "", @systemText, "", "", "", "", "", @stub)
const @systemArgValue = @argsAfter(@withSystem, "--append-system-prompt")
const @test_system_passed_as_file = @systemArgValue.includes("pi-system-") && @systemArgValue != @systemText
const @test_system_file_holds_text = @has(@withSystem, `system=${@systemText}`)
const @test_no_system_no_flag = !@hasPrefix(@unsaved, "arg=--append-system-prompt")
