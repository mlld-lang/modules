>> Tests for the arguments @runPiSh gives pi, against a stub pi that prints them.
>> Run: mlld test pi/tests/run.test.mld

import { @runPiSh } from "../index.mld"

const @fixtures = `${@root}/pi/tests/fixtures/run`
const @stub = `${@fixtures}/pi-stub.sh`
const @workdir = `${@fixtures}/workdir`
const @sid = "3c1f0b52-8e4d-4a7b-9f21-6d5e4c3b2a10"

exe @has(out, line) = js { return out.split("\n").includes(line); }
exe @hasPrefix(out, prefix) = js { return out.split("\n").some(l => l.startsWith(prefix)); }
exe @argsAfter(out, flag) = js {
  const args = out.split("\n").filter(l => l.startsWith("arg=")).map(l => l.slice(4));
  const i = args.indexOf(flag);
  return i < 0 ? "" : args[i + 1];
}
>> Emptied first so the header check sees a file this run wrote.
exe @emptyDir(dir) = sh { rm -rf "$dir"; echo "$dir" }
exe @sessionPath(dir, id) = js { return `${dir}/${id}.jsonl`; }
exe @readFile(path) = sh { cat "$path" }

>> ── dir ──

const @inDir = @runPiSh("hi", @workdir, "", "", "", "", "", "", "", "", @stub)
const @test_dir_is_pwd = @has(@inDir, `pwd=${@workdir}`)
const @test_dir_not_a_flag = !@hasPrefix(@inDir, "arg=--dir")

const @missingDir = try @runPiSh("hi", `${@fixtures}/nonexistent`, "", "", "", "", "", "", "", "", @stub)
const @test_missing_dir_fails = !@missingDir.ok

>> ── flags ──

const @flagged = @runPiSh("hi", "", "", "", "", "--no-tools --no-context-files", "", "", "", "", @stub)
const @test_flags_reach_pi = @has(@flagged, "arg=--no-context-files")
const @test_flags_word_split = @has(@flagged, "arg=--no-tools")

>> ── session ──

const @unsaved = @runPiSh("hi", "", "", "", "", "", "", "", "", "", @stub)
const @test_no_session_id_means_no_session = @has(@unsaved, "arg=--no-session")

>> @runPiSh writes a .gitignore of * into it, so the folder stays out of git.
const @sessionDir = @emptyDir(`${@fixtures}/sessions`)
const @saved = @runPiSh("hi", @workdir, "", "", "", "", "", "", @sid, @sessionDir, @stub)
const @sessionFile = @sessionPath(@sessionDir, @sid)
const @test_session_file_passed = @argsAfter(@saved, "--session") == @sessionFile
const @test_session_not_disabled = !@has(@saved, "arg=--no-session")
const @header = @readFile(@sessionFile) | @json
const @test_header_id = @header.id == @sid
const @test_header_type = @header.type == "session"
const @test_header_cwd_is_dir = @header.cwd == @workdir
const @test_session_dir_ignores_itself = @readFile(`${@sessionDir}/.gitignore`).trim() == "*"
