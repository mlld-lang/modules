>> Tests for the arguments @runPi gives pi, against a stub pi that prints them.
>> Run: mlld test pi/tests/run.test.mld

import { @runPi, @pi } from "../index.mld"

const @fixtures = `${@root}/pi/tests/fixtures/run`
const @stub = `${@fixtures}/stub/pi`
const @workdir = `${@fixtures}/workdir`
const @sid = "3c1f0b52-8e4d-4a7b-9f21-6d5e4c3b2a10"

exe @has(out, line) = js { return out.split("\n").includes(line); }
exe @hasPrefix(out, prefix) = js { return out.split("\n").some(l => l.startsWith(prefix)); }
exe @argsAfter(out, flag) = js {
  const args = out.split("\n").filter(l => l.startsWith("arg=")).map(l => l.slice(4));
  const i = args.indexOf(flag);
  return i < 0 ? "" : args[i + 1];
}
>> Emptied first so the header check sees a file this run wrote.
exe @removeDir(dir) = cmd { rm -rf "$dir" }
exe @makeDir(dir) = cmd { mkdir -p "$dir" }
exe @emptyDir(dir) = [
  let @removed = @removeDir(@dir)
  let @made = @makeDir(@dir)
  => @dir
]
exe @readFile(path) = cmd { cat "$path" }
exe @findJsonl(dir) = cmd { find "$dir" -type f -name "*.jsonl" }
>> Every session file under an agent dir, one per line.
exe @sessionFiles(agent) = [
  let @found = @findJsonl(`${@agent}/sessions`)
  let @text = `${@found}`
  let @lines = @text.split("\n")
  let @files = for @line in @lines if @line != "" => @line
  let @sorted = @files.sort()
  => @sorted.join("\n")
]
exe @baseName(path) = js { return path.split("/").pop(); }
>> pi's rule for a cwd's folder name (session-manager.js getDefaultSessionDirPath).
exe @encodeCwd(cwd) = js { return "--" + cwd.replace(/^[/\\]/, "").replace(/[/\\:]/g, "-") + "--"; }
exe @isUuid(s) = js { return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(s); }
exe @parentName(path) = js { const parts = path.split("/"); return parts[parts.length - 2]; }

>> ── dir ──

const @inDir = @runPi("hi", @workdir, "", "", "", "", "", "", "", "", "", "", "", "", @stub)
const @test_dir_is_pwd = @has(@inDir, `pwd=${@workdir}`)
const @test_dir_not_a_flag = !@hasPrefix(@inDir, "arg=--dir")

const @missingDir = try @runPi("hi", `${@fixtures}/nonexistent`, "", "", "", "", "", "", "", "", "", "", "", "", @stub)
const @test_missing_dir_fails = !@missingDir.ok

>> ── flags ──

const @flagged = @runPi("hi", "", "", "", "", "", "", "", "--no-tools --no-context-files", "", "", "", "", "", @stub)
const @test_flags_reach_pi = @has(@flagged, "arg=--no-context-files")
const @test_flags_word_split = @has(@flagged, "arg=--no-tools")

>> Each flag is its own argument. The old sh version word-split one tool string, so
>> pi got `"read,bash"` with the quote characters in it; these rows pin that it no
>> longer does.
exe @argLine(out) = js { return out.split("\n").filter(l => l.startsWith("arg=")).map(l => l.slice(4)).join("|"); }
const @allFlags = @runPi("hi", "", "anthropic", "claude-sonnet", "", "", "read,bash", "/tmp/mcp config.json", "--x", "high", "json", "", "", "", @stub)
const @test_all_flags_line = @argLine(@allFlags) == "-p|--no-session|--provider|anthropic|--model|claude-sonnet|--tools|read,bash|--mcp-config|/tmp/mcp config.json|--x|--thinking|high|--mode|json"
const @noToolsMcp = @runPi("hi", "", "", "", "", "1", "", "/tmp/mcp.json", "", "", "", "", "", "", @stub)
const @test_no_tools_with_mcp_line = @argLine(@noToolsMcp) == "-p|--no-session|--no-tools|--mcp-config|/tmp/mcp.json"

>> config.tools goes through the runtime's tool bridge, which sets @mx.llm.
const @viaTools = @pi("hi", { piBin: @stub, session: false, tools: ["read", "bash"] })
const @test_tools_native_unquoted = @argsAfter(@viaTools, "--tools") == "read,bash"
const @test_tools_mcp_config = @hasPrefix(@viaTools, "arg=--mcp-config")

>> piBin has to name a file called pi.
const @wrongBin = try @pi("hi", { piBin: `${@fixtures}/pi-stub.sh`, session: false })
const @test_pibin_other_name_refused = !@wrongBin.ok && @wrongBin.error.message.includes("piBin must be a file named pi")

>> ── session ──

const @unsaved = @runPi("hi", "", "", "", "", "", "", "", "", "", "", "", "", "", @stub)
const @test_no_session_id_means_no_session = @has(@unsaved, "arg=--no-session")

>> A session is saved in pi's own layout: <agent>/sessions/<encoded cwd>/<timestamp>_<id>.jsonl.
const @agentDir = @emptyDir(`${@fixtures}/agent`)
const @saved = @runPi("hi", @workdir, "", "", "", "", "", "", "", "", "", @sid, @agentDir, "", @stub)
const @sessionFile = @sessionFiles(@agentDir).trim()
const @test_one_session_file = @sessionFile != "" && !@sessionFile.includes("\n")
const @test_session_file_passed = @argsAfter(@saved, "--session") == @sessionFile
const @test_session_not_disabled = !@has(@saved, "arg=--no-session")
const @test_session_file_named_by_pi_rule = @baseName(@sessionFile).endsWith(`_${@sid}.jsonl`) && @baseName(@sessionFile).length == 24 + 1 + 36 + 6
const @test_session_dir_is_encoded_cwd = @parentName(@sessionFile) == @encodeCwd(@workdir)
const @header = @readFile(@sessionFile) | @json
const @test_header_id = @header.id == @sid
const @test_header_type = @header.type == "session"
const @test_header_cwd_is_dir = @header.cwd == @workdir

>> The same id again continues the file it already has, from any directory.
const @again = @runPi("hi", "", "", "", "", "", "", "", "", "", "", @sid, @agentDir, "", @stub)
const @test_same_id_same_file = @argsAfter(@again, "--session") == @sessionFile
const @test_same_id_no_second_file = @sessionFiles(@agentDir).trim() == @sessionFile

>> Through @pi with sessions on (the default): the harness profile lets the
>> stub pi append to the session file.
const @piAgent = @emptyDir(`${@fixtures}/pi-agent`)
const @viaPi = @pi("hi", { sessionId: @sid, agentDir: @piAgent, piBin: `${@fixtures}/append-stub/pi` })
const @piSessionFile = @sessionFiles(@piAgent).trim()
const @test_pi_reports_file = @viaPi.trim() == `appended=${@piSessionFile}`
const @test_pi_stub_wrote_session = @readFile(@piSessionFile).includes('"type":"message"')

>> ── system prompt ──

>> The text reaches pi through a file, unchanged, backticks and ${…} included.
const @systemText = "Answer in `code` only, never ${literally}; say \"ok\"."
const @withSystem = @runPi("hi", "", "", "", @systemText, "", "", "", "", "", "", "", "", "", @stub)
const @systemArgValue = @argsAfter(@withSystem, "--append-system-prompt")
const @test_system_passed_as_file = @systemArgValue.includes("pi-system-") && @systemArgValue != @systemText
const @test_system_file_holds_text = @has(@withSystem, `system=${@systemText}`)
const @test_no_system_no_flag = !@hasPrefix(@unsaved, "arg=--append-system-prompt")

>> ── runtime continue: fork, never resume in place ──

>> The config the runtime builds for a native continue, plus the stub, a working
>> directory, and an agent dir standing in for ~/.pi/agent.
exe @runtimeResume(bin, agent, dir, sessionId, fork) = js {
  const resume = { sessionId, provider: "pi", continue: true };
  if (fork) resume.fork = true;
  return { piBin: bin, agentDir: agent, dir, _mlld: { resume } };
}
>> A scratch agent dir holding a copy of the conversation fixtures' saved session.
exe @copyDir(from, to) = cmd { cp -R "$from" "$to" }
exe @forkAgent(dir, home) = [
  let @emptied = @emptyDir(@dir)
  let @copied = @copyDir(`${@home}/sessions`, `${@dir}/sessions`)
  => @dir
]

const @forkSid = "7e5e5e5e-1234-4321-8abc-def012345678"
const @forkHome = @forkAgent(`${@fixtures}/fork-agent`, `${@root}/pi/tests/fixtures/conversation/home`)
const @forkSource = `${@forkHome}/sessions/--tmp-proj--/2026-09-10T00-22-39-649Z_${@forkSid}.jsonl`
const @forked = @pi("again", @runtimeResume(@stub, @forkHome, @workdir, @forkSid, true))
const @test_fork_names_source = @argsAfter(@forked, "--fork") == @forkSource
const @forkNewId = @argsAfter(@forked, "--session-id")
const @test_fork_new_session_id = @isUuid(@forkNewId) && @forkNewId != @forkSid
const @test_fork_session_dir_under_agent = @argsAfter(@forked, "--session-dir") == `${@forkHome}/sessions/${@encodeCwd(@workdir)}`
const @test_fork_no_session_flag = !@has(@forked, "arg=--session") && !@has(@forked, "arg=--no-session")
>> pi writes the branch itself and refuses an id that already has a file.
const @test_fork_writes_no_file_first = @sessionFiles(@forkHome).trim() == @forkSource

const @unknownFork = try @pi("again", @runtimeResume(@stub, @forkHome, @workdir, "7e5e5e5e-1234-4321-8abc-def012345679", true))
const @test_fork_unknown_session_fails = !@unknownFork.ok
const @test_fork_unknown_session_says_so = @unknownFork.error.message.includes("no saved session 7e5e5e5e-1234-4321-8abc-def012345679 to fork")

const @badFork = try @pi("again", @runtimeResume(@stub, @forkHome, @workdir, "../../x", true))
const @test_fork_non_uuid_fails = !@badFork.ok && @badFork.error.message.includes("must be a UUID")

>> Without fork a runtime resume is ignored: today's fresh-session line.
const @notForked = @pi("again", @runtimeResume(@stub, @forkHome, @workdir, @forkSid, false))
const @freshFile = @argsAfter(@notForked, "--session")
const @test_resume_without_fork_starts_fresh = @freshFile.startsWith(`${@forkHome}/sessions/${@encodeCwd(@workdir)}/`) && !@freshFile.endsWith(`_${@forkSid}.jsonl`)
const @test_resume_without_fork_no_fork_flag = !@has(@notForked, "arg=--fork")
