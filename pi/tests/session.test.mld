>> Tests for the session @pi saves to, with no pi call.
>> Run: mlld test pi/tests/session.test.mld

import { @piSession, @piResult, @conversation } from "../index.mld"

exe @isUuid(s) = node { return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(s); }
exe @keys(o) = node { return Object.keys(o || {}).sort().join(","); }

>> ── @piSession ──

const @fresh = @piSession({})
const @fresh2 = @piSession(null)
const @test_default_id_is_lowercase_uuid = @isUuid(@fresh.sessionId)
const @test_default_agent_dir_is_pis_own = @fresh.agentDir == ""
const @test_default_ids_differ = @fresh.sessionId != @fresh2.sessionId

const @named = @piSession({ sessionId: " 3C1F0B52-8E4D-4A7B-9F21-6D5E4C3B2A10 ", agentDir: "/some/agent" })
const @test_named_id_lowercased = @named.sessionId == "3c1f0b52-8e4d-4a7b-9f21-6d5e4c3b2a10"
const @test_agent_dir_passed = @named.agentDir == "/some/agent"

const @bad = try @piSession({ sessionId: "my-session" })
const @test_non_uuid_throws = !@bad.ok
const @test_non_uuid_error_names_value = @bad.error.message.includes("my-session")

const @off = @piSession({ session: false })
const @test_off_has_no_id = @off.sessionId == ""
const @test_off_has_no_agent_dir = @off.agentDir == ""

>> ── @piResult ──

const @offResult = @piResult("answer", @off)
const @test_off_returns_raw = @offResult == "answer"

const @onResult = @piResult("answer", @named)
const @test_on_envelope_keys = @keys(@onResult) == "_mlld,value"
const @test_on_envelope_value = @onResult.value == "answer"
const @test_on_envelope_session = @onResult._mlld.sessionId == "3c1f0b52-8e4d-4a7b-9f21-6d5e4c3b2a10"
const @test_on_envelope_provider = @onResult._mlld.provider == "pi"
