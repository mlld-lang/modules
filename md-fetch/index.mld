>> Guardable alternative to built-in WebFetch tool
>> Fetches markdownified content of websites
>> Serve: mlld mcp mdfetch.mld --tools-collection @tools

>> MLLD_ALLOWED_DOMAINS: comma-separated domains, or "*" for unrestricted.
>> Set it in the process environment, or with `mlld mcp … --env MLLD_ALLOWED_DOMAINS=github.com,docs.python.org`;
>> `mlld run` has no --env, so there it must come from the environment.

import { @MLLD_ALLOWED_DOMAINS } from @input

import { @domainOf, @urlRefusal } from "./check.mld"

const @allowedDomains = @MLLD_ALLOWED_DOMAINS

>> --- HTML to markdown ---

>> Node because readability and jsdom are npm packages.
exe @htmlToMarkdown(html, url) = node {
  const raw = String(html);
  const trimmed = raw.trimStart();
  if (!trimmed.startsWith('<') && !trimmed.toLowerCase().startsWith('<!doctype')) {
    return raw.slice(0, 50000);
  }
  const { JSDOM } = require('jsdom');
  const { Readability } = require('@mozilla/readability');
  const dom = new JSDOM(trimmed, { url });
  const reader = new Readability(dom.window.document);
  const article = reader.parse();
  if (!article) {
    return raw.replace(/<script[^>]*>[\s\S]*?<\/script>/gi, '')
      .replace(/<style[^>]*>[\s\S]*?<\/style>/gi, '')
      .replace(/<[^>]+>/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
      .slice(0, 50000);
  }
  return `# ${article.title}\n\n${article.textContent.trim()}`.slice(0, 50000);
}

>> --- Core fetch ---

exe .op:net:r @mdFetch(url: string) with { description: "Fetch markdownified web content from a provided HTTPS url" } = [
  let @refusal = @urlRefusal(@url, @allowedDomains)
  if @refusal [
    => @refusal
  ]

  >> Accept: text/markdown, because Cloudflare sites then return markdown directly.
  >> @http follows redirects, caps the body at 5 MB and refuses private addresses.
  let @res = @http.request(@url, { method: "GET", headers: { Accept: "text/markdown" } }) with { timeout: 30000 }
  let @raw = @res.body.isString() ? @res.body : `${@res.body}`

  >> If response is still HTML, extract content with readability
  let @content = @htmlToMarkdown(@raw, @url)

  => { url: @url, domain: @domainOf(@url), content: @content }
]

>> --- Tool collection ---

tools @tools = {
  mdFetch: {
    mlld: @mdFetch,
    labels: [.op:net:r],
    description: "Fetch markdownified web content from provided HTTPS url"
  }
}

export { @mdFetch, @tools }
