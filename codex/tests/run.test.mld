>> Tests for the codex command line @codex and @runCodex build, against stub
>> codexes that print the arguments they were given. No model is called.
>> Run: mlld test codex/tests/

import { @codex, @parseCodexJsonl, @runCodex } from "../index.mld"

const @stub = `${@root}/codex/tests/fixtures/bin/codex`
const @sid = "0c0ffee0-1234-4321-8abc-def012345678"

>> The config the runtime builds for a native continue, plus the stub and a sandbox.
exe @runtimeResume(bin, fork) = js {
  const resume = { sessionId: "0c0ffee0-1234-4321-8abc-def012345678", provider: "codex", continue: true };
  if (fork) resume.fork = true;
  return { codexBin: bin, sandbox: "read-only", _mlld: { resume } };
}

>> ── runtime continue: fork, never resume in place ──

>> The sandbox flag goes before `fork`: codex refuses it after the subcommand.
const @forked = @codex("again", @runtimeResume(@stub, true))
const @test_runtime_fork_line = @forked == `stub codex: exec -s read-only fork ${@sid} --json --skip-git-repo-check -m gpt-5.4 - | again`

>> Without fork a runtime resume is today's resume line.
const @resumed = @codex("again", @runtimeResume(@stub, false))
const @test_runtime_resume_without_fork_unchanged = @resumed == `stub codex: exec -s read-only resume ${@sid} --json --skip-git-repo-check -m gpt-5.4 - | again`

>> A fork answers with the branch's thread id, which @codex returns over the resumed one.
const @forkOutput = @parseCodexJsonl("{\"type\":\"thread.started\",\"thread_id\":\"0199a213-81c0-7800-8aa1-bbab2a035a53\"}\n{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"ok\"}}\n")
const @test_fork_reports_new_thread_id = @forkOutput.sessionId == "0199a213-81c0-7800-8aa1-bbab2a035a53" && @forkOutput.sessionId != @sid

>> ── @runCodex directly: the whole argument list ──

const @argStub = `${@root}/codex/tests/fixtures/run/codex-stub.sh`
const @workdir = `${@root}/codex/tests/fixtures/run/workdir`

>> The arguments the stub saw, joined with | so a whole command line compares at once.
exe @argv(out) = js {
  return out.split("\n").filter((l) => l.startsWith("arg=")).map((l) => l.slice(4)).join("|");
}

>> codex 0.154 removed --full-auto; workspace-write is the sandbox it stood for.
const @plain = @runCodex("hi", @workdir, "gpt-5.4", "", "", "", "", "", "", "", @argStub)
const @test_default_sandbox_line = @argv(@plain) == "exec|--json|--skip-git-repo-check|-s|workspace-write|-m|gpt-5.4|-"
const @test_default_no_full_auto = !@argv(@plain).includes("--full-auto")

const @readOnly = @runCodex("hi", @workdir, "gpt-5.4", "read-only", "", "", "", "", "", "", @argStub)
const @test_read_only_line = @argv(@readOnly) == "exec|--json|--skip-git-repo-check|-s|read-only|-m|gpt-5.4|-"

const @bypassed = @runCodex("hi", @workdir, "gpt-5.4", "", "", "1", "", "", "", "", @argStub)
const @test_bypass_line = @argv(@bypassed) == "exec|--json|--skip-git-repo-check|--dangerously-bypass-approvals-and-sandbox|-m|gpt-5.4|-"

>> codex refuses a sandbox flag after the resume and fork subcommands.
const @resumedDirect = @runCodex("hi", @workdir, "gpt-5.4", "", "", "", "", "1", @sid, "", @argStub)
const @test_resume_sandbox_before_subcommand = @argv(@resumedDirect) == `exec|-s|workspace-write|resume|${@sid}|--json|--skip-git-repo-check|-m|gpt-5.4|-`

const @resumedBypass = @runCodex("hi", @workdir, "gpt-5.4", "", "", "1", "", "1", @sid, "", @argStub)
const @test_resume_bypass_before_subcommand = @argv(@resumedBypass) == `exec|--dangerously-bypass-approvals-and-sandbox|resume|${@sid}|--json|--skip-git-repo-check|-m|gpt-5.4|-`

const @forkedDirect = @runCodex("hi", @workdir, "gpt-5.4", "", "", "", "", "1", @sid, "1", @argStub)
const @test_fork_sandbox_before_subcommand = @argv(@forkedDirect) == `exec|-s|workspace-write|fork|${@sid}|--json|--skip-git-repo-check|-m|gpt-5.4|-`
