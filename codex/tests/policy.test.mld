>> @codex under a policy with command rules: the program is the literal `codex`,
>> and codexBin reaches its stub through the call's PATH, so neither is refused.
>> Run: mlld test codex/tests/

import { @codex } from "../index.mld"

policy @rules = { * { capabilities: { deny: ["cmd:rm"] } } }

const @stub = `${@root}/codex/tests/fixtures/bin/codex`

const @out = @codex("hi", { codexBin: @stub, sandbox: "read-only" })
const @test_stub_runs_under_policy = @out == "stub codex: exec --json --skip-git-repo-check -s read-only -m gpt-5.4 - | hi"

>> Only a file named codex can be put in front on PATH.
const @misnamed = try @codex("hi", { codexBin: `${@root}/codex/tests/fixtures/run/codex-stub.sh` })
const @test_misnamed_bin_refused = !@misnamed.ok && @misnamed.error.message.includes("config.codexBin must be a file named codex")

>> A missing file would otherwise fall through to the codex on PATH.
const @missing = try @codex("hi", { codexBin: "/nonexistent/codex" })
const @test_missing_bin_refused = !@missing.ok && @missing.error.message.includes("config.codexBin is not an executable file")

>> A folder named codex would otherwise fall
>> through to the codex on PATH.
const @folder = try @codex("hi", { codexBin: `${@root}/codex/tests/fixtures/folder/codex` })
const @test_folder_bin_refused = !@folder.ok && @folder.error.message.includes("config.codexBin is not an executable file")

>> A relative path is checked from here but looked up from dir, so with a dir it
>> would miss and run the codex on PATH.
const @relative = try @codex("hi", { codexBin: "codex/tests/fixtures/bin/codex", dir: "/tmp" })
const @test_relative_bin_refused = !@relative.ok && @relative.error.message.includes("config.codexBin must be an absolute path")

>> A ':' splits the PATH entry, so the lookup would miss the folder.
const @colon = try @codex("hi", { codexBin: "/a:b/codex" })
const @test_colon_bin_refused = !@colon.ok && @colon.error.message.includes("config.codexBin must not contain ':'")
