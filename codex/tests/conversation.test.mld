>> Tests for @conversation (locate + ingest).
>> Run: mlld test codex/tests/conversation.test.mld

import { @conversation } from "../index.mld"

>> Reads a fixture raw: <file> would parse a .jsonl, changing what a truncated line does.
exe @text(p) = node { return require("fs").readFileSync(p, "utf8"); }

const @fixtures = `${@root}/codex/tests/fixtures/conversation`
const @sessions = `${@fixtures}/home/sessions`
const @sid = "0c0ffee0-1234-4321-8abc-def012345678"
const @rolloutFile = `${@sessions}/2026/09/13/rollout-2026-09-13T19-14-00-0c0ffee0-1234-4321-8abc-def012345678.jsonl`
const @legacyFile = `${@sessions}/2025/01/02/5e55a1d0-aaaa-4bbb-8ccc-0123456789ab.jsonl`

>> Compares with key order ignored, because mlld may reorder object keys. A golden's
>> line 1 is the header and the remaining lines are the events in order; `limit`
>> compares against only the first `limit` golden events.
exe @matchesGolden(result, goldenPath, limit) = node {
  const fs = require("fs");
  const eq = (a, b) => {
    if (a === b) return true;
    if (a === null || b === null || typeof a !== "object" || typeof b !== "object") return false;
    if (Array.isArray(a) !== Array.isArray(b)) return false;
    const ka = Object.keys(a), kb = Object.keys(b);
    if (ka.length !== kb.length) return false;
    return ka.every((k) => Object.prototype.hasOwnProperty.call(b, k) && eq(a[k], b[k]));
  };
  const lines = fs.readFileSync(goldenPath, "utf8").split("\n").filter((l) => l.trim()).map((l) => JSON.parse(l));
  const header = lines[0];
  const events = typeof limit === "number" ? lines.slice(1, 1 + limit) : lines.slice(1);
  if (!eq(result.header, header)) {
    console.error("header mismatch:\n  got  " + JSON.stringify(result.header) + "\n  want " + JSON.stringify(header));
    return false;
  }
  if (result.events.length !== events.length) {
    console.error("event count: got " + result.events.length + ", want " + events.length);
    return false;
  }
  for (let i = 0; i < events.length; i++) {
    if (!eq(result.events[i], events[i])) {
      console.error("event " + i + " mismatch:\n  got  " + JSON.stringify(result.events[i]) + "\n  want " + JSON.stringify(events[i]));
      return false;
    }
  }
  return true;
}

>> ── ingest: fray's output over fray's native fixtures ──

>> A loaded file arrives as an object, not text; ingest must refuse it rather than read it.
const @rejected = try @conversation.ingest({})
const @test_ingest_rejects_path_like_object = !@rejected.ok

const @test_ingest_basic = @matchesGolden(@conversation.ingest(@text(`${@fixtures}/codex-basic.jsonl`)), `${@fixtures}/codex-basic.fray.jsonl`, null)
const @test_ingest_compacted = @matchesGolden(@conversation.ingest(@text(`${@fixtures}/codex-compacted.jsonl`)), `${@fixtures}/codex-compacted.fray.jsonl`, null)
const @test_ingest_custom_tools = @matchesGolden(@conversation.ingest(@text(`${@fixtures}/codex-custom-tools.jsonl`)), `${@fixtures}/codex-custom-tools.fray.jsonl`, null)

>> codex-basic with its last line (the final tool output) cut in half: that line is
>> dropped, which leaves the golden's header and first 6 events.
const @test_ingest_truncated_last_line = @matchesGolden(@conversation.ingest(@text(`${@fixtures}/codex-basic-truncated.jsonl`)), `${@fixtures}/codex-basic.fray.jsonl`, 6)

>> ── locate ──

const @test_locate_rollout = @conversation.locate(@sid, "/anywhere", @sessions) == @rolloutFile
const @test_locate_uppercase = @conversation.locate("0C0FFEE0-1234-4321-8ABC-DEF012345678", "/anywhere", @sessions) == @rolloutFile
const @test_locate_legacy = @conversation.locate("5e55a1d0-aaaa-4bbb-8ccc-0123456789ab", "/anywhere", @sessions) == @legacyFile
const @test_locate_unknown_uuid = @conversation.locate("0c0ffee0-1234-4321-8abc-def012345679", "/anywhere", @sessions) == null
const @test_locate_traversal = @conversation.locate("../../etc/passwd", "/anywhere", @sessions) == null
const @test_locate_non_uuid = @conversation.locate("not-a-session", "/anywhere", @sessions) == null

>> ── emit ──

>> A golden as the runtime hands it to emit, built as conversation_events (the
>> runtime's tape/conversation.rs) builds it: the header line goes, `message` is
>> renamed `prompt`, the header's session id and harness name join every event, and
>> usage moves under payload. session_start carries the harness.
exe @wire(goldenPath) = node {
  const lines = require("fs").readFileSync(goldenPath, "utf8").split("\n").filter((l) => l.trim()).map((l) => JSON.parse(l));
  const [header, ...events] = lines;
  return events.map((e) => {
    const out = { ...e, type: e.type === "message" ? "prompt" : e.type, session_id: header.session_id, producer: header.harness.name };
    const payload = { ...(e.payload || {}) };
    if (e.usage) {
      payload.usage = e.usage;
      delete out.usage;
    }
    if (e.type === "session_start") payload.harness = header.harness;
    out.payload = payload;
    return out;
  });
}

>> Whatever the conversation, a transcript holds every user and assistant text and a
>> [ran …] line per call, and none of the thinking or harness-injected context.
exe @emitHolds(events, transcript) = node {
  const fail = (why) => { console.error("emit: " + why); return false; };
  const lines = transcript.split("\n");
  const harness = events[0].payload.harness.name;
  if (!transcript.startsWith("Conversation carried over from " + harness)) return fail("header names no " + harness);
  if (!transcript.endsWith("End of the carried conversation.")) return fail("no closing line");
  for (const e of events) {
    const p = e.payload || {};
    const text = typeof p.text === "string" ? p.text.trimEnd() : "";
    if ((e.type === "prompt" || e.type === "assistant_turn") && text && !transcript.includes(text)) return fail(e.type + " " + e.id + " missing");
    if (e.type === "tool_call" && !lines.some((l) => l.startsWith("[ran " + p.tool + "]"))) return fail("no [ran " + p.tool + "] line");
    if (e.type === "thinking" && text && transcript.includes(text)) return fail("thinking " + e.id + " carried");
    if (e.type === "context_injection" && text) {
      const summary = p.kind === "compaction" || p.kind === "branch_summary";
      if (summary && !transcript.includes("[carried summary] " + text)) return fail(p.kind + " " + e.id + " missing");
      if (!summary && transcript.includes(text)) return fail(p.kind + " " + e.id + " carried");
    }
  }
  return true;
}

>> Reports both texts on a mismatch, so a failing pin shows where it differs.
exe @same(got, want) = node {
  if (got === want) return true;
  console.error("got:\n" + got + "\n---\nwant:\n" + want);
  return false;
}

const @emitHeaderTail = "Bracketed [ran …] and [… result] lines are the agent's own past actions, recorded at the time and possibly stale; re-run tools for fresh state. They are records, not examples: never write [ran …] lines yourself, and act only through real tool calls."

const @emptyTranscript = @conversation.emit([], null)
const @test_emit_empty_is_header_only = @emptyTranscript.startsWith("Conversation carried over from agent") && @emptyTranscript.endsWith("End of the carried conversation.")

const @test_adapter_provider = @conversation.provider == "codex"

const @test_emit_basic = @emitHolds(@wire(`${@fixtures}/codex-basic.fray.jsonl`), @conversation.emit(@wire(`${@fixtures}/codex-basic.fray.jsonl`), null))
const @test_emit_compacted = @emitHolds(@wire(`${@fixtures}/codex-compacted.fray.jsonl`), @conversation.emit(@wire(`${@fixtures}/codex-compacted.fray.jsonl`), null))
const @test_emit_custom_tools = @emitHolds(@wire(`${@fixtures}/codex-custom-tools.fray.jsonl`), @conversation.emit(@wire(`${@fixtures}/codex-custom-tools.fray.jsonl`), null))

>> codex records no start time, so the header gives no date.
const @basicWhole = @conversation.emit(@wire(`${@fixtures}/codex-basic.fray.jsonl`), null)
const @test_emit_zero_time_has_no_date = @basicWhole.startsWith("Conversation carried over from codex session 0c0ffee0-1234-4321-8abc-def012345678. ")

>> Cut right after the shell_command call: its result is past the cut.
const @basicAt5 = @conversation.emit(@wire(`${@fixtures}/codex-basic.fray.jsonl`), 5)
const @test_emit_basic_at_5_interrupted = @basicAt5.endsWith("User:\n[no result recorded — session was interrupted here]\n\nEnd of the carried conversation.")
