>> DuckDuckGo web search
>> Requires: pip install ddgs

>> Python because ddgs is a Python library. It prints JSON for @search to parse.
exe @ddgText(query, maxResults) = py {
  from ddgs import DDGS
  import json
  limit = int(maxResults) if maxResults else 5
  results = DDGS().text(query, max_results=limit)
  print(json.dumps(results))
}

exe .op:net:r @search(query: string, maxResults: number) with { description: "Search DuckDuckGo and return web results" } = @ddgText(@query, @maxResults) | @parse

tools @tools = {
  search: {
    mlld: @search,
    labels: [.op:net:r],
    description: "Search DuckDuckGo and return web results"
  }
}

export { @search, @tools }
