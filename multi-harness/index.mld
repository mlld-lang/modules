---
name: multi-harness
author: mlld
version: 0.3.0
about: One @agent that runs claude, codex, pi or opencode, picked by config.harness or the first one ready
license: CC0
---

needs { js: [] }

import @mlld/claude as @claudeHarness
import @mlld/codex as @codexHarness
import @mlld/pi as @piHarness
import @mlld/opencode as @opencodeHarness

>> js because mlld has no throw; a thrown error is what lets callers catch it with `try`.
exe @raise(message) = js {
  throw new Error(message);
}

exe @unknownHarness(harness) = @raise(`multi-harness: unknown harness '${@harness}' (supported: auto, claude, codex, pi, opencode)`)

>> ── Sign-in checks ──
>>
>> Each check answers "ready" or why not, and never calls a model, so auto costs
>> nothing. A check failing for an unexpected reason only skips to the next tool.
>> The bin argument is the config's …Bin key: a file named after the tool whose
>> folder goes first on PATH for the check, as the harness module does for the
>> run; empty means the tool on PATH. Each command writes its program literally
>> because mlld refuses a command whose program comes from a variable.

>> mlld reads only a few named environment variables, so these come from the shell.
exe @shellPath() = cmd { printf '%s' "$PATH" }
exe @piAgentDir() = cmd { printf '%s' "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" }
exe @xdgDataHome() = cmd { printf '%s' "${XDG_DATA_HOME:-$HOME/.local/share}" }

>> `command -v` runs nothing; it fails when the name isn't found.
exe @onPath(name) = cmd { command -v "$name" }
exe @isExecutable(file) = cmd { test -f "$file" -a -x "$file" }
>> Fails when the variable is unset or empty; its value never enters mlld.
exe @envSet(key) = cmd { printenv "$key" | grep -q . }

>> The PATH a check runs with: "" for the tool on PATH, the bin's folder in front
>> otherwise, or null when bin is not an absolute path to a runnable file called
>> `name`.
exe @checkPath(bin, name) = [
  if !@bin || @bin == @name [
    let @found = try @onPath(@name)
    => @found.ok ? "" : null
  ]
  if !@bin.startsWith("/") || !@bin.endsWith(`/${@name}`) [ => null ]
  let @found = try @isExecutable(@bin)
  if !@found.ok [ => null ]
  => `${@bin.slice(0, @bin.length - @name.length - 1)}:${@shellPath()}`
]

exe @claudeAuthStatus() = cmd { env -u CLAUDECODE claude auth status --json }
exe @codexLoginStatus() = cmd { codex login status }
exe @piAuthCheck(provider) = cmd { pi auth check --provider "$provider" --json }

>> A check runs the tool itself, which may write its own state (pi locks its
>> auth file), so it gets the same fence profile as that tool's harness; only
>> `llm` definitions can declare one.
llm @claudeStatus(bin) using { harness: { write: [".", "~/.claude", "~/.claude.json"], net: "open" } } = [
  let @path = @checkPath(@bin, "claude")
  if @path == null [ => "not installed" ]
  let @out = match [
    @path => try @claudeAuthStatus() using { env: { PATH: @path } }
    * => try @claudeAuthStatus()
  ]
  if !@out.ok [ => "not signed in" ]
  let @status = try @out.value | @parse
  => @status.ok && @status.value.loggedIn == true ? "ready" : "not signed in"
]

llm @codexStatus(bin) using { harness: { write: [".", "~/.codex"], net: "open" } } = [
  let @path = @checkPath(@bin, "codex")
  if @path == null [ => "not installed" ]
  let @out = match [
    @path => try @codexLoginStatus() using { env: { PATH: @path } }
    * => try @codexLoginStatus()
  ]
  => @out.ok ? "ready" : "not signed in"
]

>> `pi auth check` needs a provider, so without config.provider this uses the
>> defaultProvider from pi's own settings, as a pi run would.
exe @piDefaultProvider() = [
  let @settingsPath = `${@piAgentDir()}/settings.json`
  let @settings = try <@settingsPath>
  => @settings.ok && @settings.value.defaultProvider.isString() ? @settings.value.defaultProvider : ""
]

llm @piStatus(bin, provider) using { harness: { write: [".", "~/.pi/agent"], net: "open" } } = [
  let @path = @checkPath(@bin, "pi")
  if @path == null [ => "not installed" ]
  let @p = @provider ? @provider : @piDefaultProvider()
  if !@p [ => "not signed in (no provider set)" ]
  let @out = match [
    @path => try @piAuthCheck(@p) using { env: { PATH: @path } }
    * => try @piAuthCheck(@p)
  ]
  if !@out.ok [ => "not signed in" ]
  let @status = try @out.value | @parse
  => @status.ok && @status.value.status == "ready" ? "ready" : "not signed in"
]

>> Reads opencode's auth file instead of running `opencode auth list`, so the
>> check starts no opencode process. A <PROVIDER>_API_KEY variable also counts,
>> since opencode reads those too.
exe @opencodeStatus(bin, model, dataHome) = [
  if @checkPath(@bin, "opencode") == null [ => "not installed" ]
  let @p = @model.split("/")[0]
  let @dataDir = @dataHome ? @dataHome : @xdgDataHome()
  let @authPath = `${@dataDir}/opencode/auth.json`
  let @auth = try <@authPath>
  if @auth.ok && @auth.value[@p].isDefined() [ => "ready" ]
  let @key = `${@p.toUpperCase().replaceAll("-", "_")}_API_KEY`
  let @hasKey = try @envSet(@key)
  => @hasKey.ok ? "ready" : "not signed in"
]

>> The tool config.harness names; for "auto" or no harness, the first ready one
>> in the order claude, codex, pi, opencode, logged to stderr. Checks stop at the
>> first ready tool.
exe @pickHarness(config) = [
  let @cfg = @config ?? {}
  let @asked = @cfg.harness ?? "auto"
  if @asked != "auto" [ => @asked ]
  >> Fallbacks are settled before any check: a `??` evaluated after an `if` on
  >> a check's output picks up that output's .src label.
  let @claudeBin = @cfg.claudeBin ?? ""
  let @codexBin = @cfg.codexBin ?? ""
  let @piBin = @cfg.piBin ?? ""
  let @piProvider = @cfg.provider ?? ""
  let @opencodeBin = @cfg.opencodeBin ?? ""
  let @opencodeModel = @cfg.model ?? "openrouter/z-ai/glm-5.1"
  let @opencodeData = @cfg.dataHome ?? ""
  let @claudeWhy = @claudeStatus(@claudeBin)
  if @claudeWhy == "ready" [
    log "multi-harness: auto picked claude"
    => "claude"
  ]
  let @codexWhy = @codexStatus(@codexBin)
  if @codexWhy == "ready" [
    log `multi-harness: auto picked codex (claude: ${@claudeWhy})`
    => "codex"
  ]
  let @piWhy = @piStatus(@piBin, @piProvider)
  if @piWhy == "ready" [
    log `multi-harness: auto picked pi (claude: ${@claudeWhy}; codex: ${@codexWhy})`
    => "pi"
  ]
  let @opencodeWhy = @opencodeStatus(@opencodeBin, @opencodeModel, @opencodeData)
  if @opencodeWhy == "ready" [
    log `multi-harness: auto picked opencode (claude: ${@claudeWhy}; codex: ${@codexWhy}; pi: ${@piWhy})`
    => "opencode"
  ]
  => @raise(`multi-harness: no harness available (claude: ${@claudeWhy}; codex: ${@codexWhy}; pi: ${@piWhy}; opencode: ${@opencodeWhy})`)
]

>> Runs the prompt on config.harness, or on the tool @pickHarness finds for
>> "auto". The whole config goes to that harness as is, so its own keys
>> (sandbox, thinking, agent, …) and its own model default apply.
llm @agent(prompt, config) = [
  let @cfg = @config ?? {}
  let @harness = @pickHarness(@cfg)
  => match @harness [
    "claude" => @claudeHarness.claude(@prompt, @cfg)
    "codex" => @codexHarness.codex(@prompt, @cfg)
    "pi" => @piHarness.pi(@prompt, @cfg)
    "opencode" => @opencodeHarness.opencode(@prompt, @cfg)
    * => @unknownHarness(@harness)
  ]
]

>> The harness's own { locate, ingest }. Their signatures differ per harness
>> (opencode's locate also takes the opencode binary), so they are not merged.
exe @conversation(harness) = match @harness [
  "claude" => @claudeHarness.conversation
  "codex" => @codexHarness.conversation
  "pi" => @piHarness.conversation
  "opencode" => @opencodeHarness.conversation
  * => @unknownHarness(@harness)
]

export { @agent, @pickHarness, @conversation }
