needs { network }

>> Looked up in the keychain first, then the OPENAI_API_KEY environment variable.
creds @openai = "OPENAI_API_KEY"

>> ── Request ──
>> The chat/completions body, built in mlld so it can be read and tested apart
>> from the network call.
exe @openaiRequest(prompt, cfg) = [
  let @sys = @cfg.system ? [{ role: "system", content: @cfg.system }] : []
  let @prior = @cfg.messages && @cfg.messages.isArray() ? @cfg.messages : []
  let @temperature = @cfg.temperature != null ? { temperature: @cfg.temperature } : {}
  let @maxTokens = @cfg.maxTokens ? { max_tokens: @cfg.maxTokens } : {}
  let @format = @cfg.responseFormat ? { response_format: @cfg.responseFormat } : {}
  let @fnTools = @cfg.fnTools ? { tools: @cfg.fnTools } : {}
  let @fnToolChoice = @cfg.fnToolChoice ? { tool_choice: @cfg.fnToolChoice } : {}
  => {
    model: @cfg.model ?? "gpt-4o",
    messages: [...@sys, ...@prior, { role: "user", content: @prompt }],
    ...@temperature,
    ...@maxTokens,
    ...@format,
    ...@fnTools,
    ...@fnToolChoice
  }
]

>> ── Response ──

>> js because mlld has no throw; a thrown error is what lets callers catch it with `try`.
exe @raise(message) = js {
  throw new Error(message);
}

>> OpenAI sends a call's arguments as JSON text.
exe @openaiToolCall(call) = [
  let @args = @call.function.arguments | @parse
  => { function: @call.function.name, args: @args }
]

>> The reply text, or { type: "tool_calls", tool_calls: [{ function, args }] } when
>> the model called functions. A non-2xx status raises.
exe @openaiResult(res) = [
  if !@res.ok [ => @raise(`OpenAI API ${@res.status}: ${@res.body}`) ]
  let @msg = @res.body.choices[0].message
  let @calls = for @c in (@msg.tool_calls ?? []) => @openaiToolCall(@c)
  => match [
    @calls.length > 0 => { type: "tool_calls", tool_calls: @calls }
    * => @msg.content
  ]
]

>> ── Network call ──

exe @openaiPost(body, baseUrl) = [
  let @res = @http.post(`${@baseUrl || "https://api.openai.com/v1"}/chat/completions`, @body) using creds:openai
  => @openaiResult(@res)
]

>> ── Core invocation ──

>> @openai(prompt, config)
>> config.model          - model name (default: gpt-4o)
>> config.system         - system prompt
>> config.messages       - prior conversation turns (array of {role, content})
>> config.temperature    - sampling temperature
>> config.maxTokens      - max output tokens
>> config.responseFormat - e.g. { type: "json_object" }
>> config.fnTools        - array of tool definitions for native function calling
>> config.fnToolChoice   - "auto", "required", "none", or {type: "function", function: {name: "..."}}
>> config.baseUrl        - API base URL (default: https://api.openai.com/v1)
>>
>> Replies arrive whole: mlld's @http reads a response only once it is complete,
>> so there is no streaming.
llm @openai(prompt, config) = [
  let @cfg = @config ? @config : {}
  => @openaiPost(@openaiRequest(@prompt, @cfg), @cfg.baseUrl)
]

>> ── Model shortcuts ──

llm @gpt4o(prompt) = @openai(@prompt, { model: "gpt-4o" })
llm @gpt4oMini(prompt) = @openai(@prompt, { model: "gpt-4o-mini" })
llm @o3Mini(prompt) = @openai(@prompt, { model: "o3-mini" })

export { @openai, @gpt4o, @gpt4oMini, @o3Mini, @openaiRequest, @openaiResult }
