>> Tests for @conversation (locate + ingest) and @claudeStreamSession.
>> Run: mlld test claude/tests/conversation.test.mld

import { @conversation, @claudeStreamSession } from "../index.mld"

>> Reads a fixture raw: <file> would parse a .jsonl, changing what a truncated line does.
exe @text(p) = node { return require("fs").readFileSync(p, "utf8"); }

const @fixtures = `${@root}/claude/tests/fixtures/conversation`
const @home = `${@fixtures}/home`
const @sid = "3f2a1b4c-0000-4000-8000-abcdef000001"
const @sessionFile = `${@home}/projects/-work-fixture-proj/3f2a1b4c-0000-4000-8000-abcdef000001.jsonl`

>> Compares with key order ignored, because mlld may reorder object keys; a golden's
>> line 1 is the header and the remaining lines are the events in order.
exe @matchesGolden(result, goldenPath) = node {
  const fs = require("fs");
  const eq = (a, b) => {
    if (a === b) return true;
    if (a === null || b === null || typeof a !== "object" || typeof b !== "object") return false;
    if (Array.isArray(a) !== Array.isArray(b)) return false;
    const ka = Object.keys(a), kb = Object.keys(b);
    if (ka.length !== kb.length) return false;
    return ka.every((k) => Object.prototype.hasOwnProperty.call(b, k) && eq(a[k], b[k]));
  };
  const lines = fs.readFileSync(goldenPath, "utf8").split("\n").filter((l) => l.trim()).map((l) => JSON.parse(l));
  const [header, ...events] = lines;
  if (!eq(result.header, header)) {
    console.error("header mismatch:\n  got  " + JSON.stringify(result.header) + "\n  want " + JSON.stringify(header));
    return false;
  }
  if (result.events.length !== events.length) {
    console.error("event count: got " + result.events.length + ", want " + events.length);
    return false;
  }
  for (let i = 0; i < events.length; i++) {
    if (!eq(result.events[i], events[i])) {
      console.error("event " + i + " mismatch:\n  got  " + JSON.stringify(result.events[i]) + "\n  want " + JSON.stringify(events[i]));
      return false;
    }
  }
  return true;
}

exe @isLowerUuid(s) = js {
  return typeof s === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(s);
}

>> ── ingest: fray's output over fray's native fixtures ──

>> A loaded file arrives as an object, not text; ingest must refuse it rather than read it.
const @rejected = try @conversation.ingest({})
const @test_ingest_rejects_path_like_object = !@rejected.ok

const @test_ingest_attachments = @matchesGolden(@conversation.ingest(@text(`${@fixtures}/claude-attachments.jsonl`)), `${@fixtures}/claude-attachments.fray.jsonl`)
const @test_ingest_basic = @matchesGolden(@conversation.ingest(@text(`${@fixtures}/claude-basic.jsonl`)), `${@fixtures}/claude-basic.fray.jsonl`)
const @test_ingest_branched = @matchesGolden(@conversation.ingest(@text(`${@fixtures}/claude-branched.jsonl`)), `${@fixtures}/claude-branched.fray.jsonl`)
const @test_ingest_compacted = @matchesGolden(@conversation.ingest(@text(`${@fixtures}/claude-compacted.jsonl`)), `${@fixtures}/claude-compacted.fray.jsonl`)
const @test_ingest_headless_thinking = @matchesGolden(@conversation.ingest(@text(`${@fixtures}/claude-headless-thinking.jsonl`)), `${@fixtures}/claude-headless-thinking.fray.jsonl`)

>> ── locate ──

const @test_locate_lowercase = @conversation.locate(@sid, "/work/fixture-proj", @home) == @sessionFile
const @test_locate_uppercase = @conversation.locate("3F2A1B4C-0000-4000-8000-ABCDEF000001", "/work/fixture-proj", @home) == @sessionFile
const @test_locate_fallback_other_slug = @conversation.locate(@sid, "/somewhere/else", @home) == @sessionFile
const @test_locate_unknown_uuid = @conversation.locate("3f2a1b4c-0000-4000-8000-abcdef000002", "/work/fixture-proj", @home) == null
const @test_locate_traversal = @conversation.locate("../../etc/passwd", "/work/fixture-proj", @home) == null
const @test_locate_non_uuid = @conversation.locate("not-a-session", "/work/fixture-proj", @home) == null

>> ── stream-mode session id ──

const @fresh = @claudeStreamSession({ continue: false, sessionId: null, provider: "claude", source: "none" })
const @test_stream_fresh_mints_lowercase_uuid = @isLowerUuid(@fresh.sessionId)
const @test_stream_fresh_flag = @fresh.flag == ` --session-id ${@fresh.sessionId}`

const @tracking = @claudeStreamSession({ continue: false, sessionId: "AAAAAAAA-0000-4000-8000-000000000001", provider: "claude", source: "runtime_tracking" })
const @test_stream_tracking_mints = @isLowerUuid(@tracking.sessionId) && @tracking.sessionId != "AAAAAAAA-0000-4000-8000-000000000001"
const @test_stream_tracking_flag = @tracking.flag == ` --session-id ${@tracking.sessionId}`

const @public = @claudeStreamSession({ continue: false, sessionId: "BBBBBBBB-0000-4000-8000-000000000002", provider: "claude", source: "public_session" })
const @test_stream_public_no_flag = @public.flag == ""
const @test_stream_public_id = @public.sessionId == "BBBBBBBB-0000-4000-8000-000000000002"

const @resuming = @claudeStreamSession({ continue: true, sessionId: "CCCCCCCC-0000-4000-8000-000000000003", provider: "claude", source: "public_resume" })
const @test_stream_resume_no_flag = @resuming.flag == ""
const @test_stream_resume_id = @resuming.sessionId == "CCCCCCCC-0000-4000-8000-000000000003"

>> A forking resume branches to a new session, so it mints an id in either mode.
const @forking = @claudeStreamSession({ continue: true, sessionId: "CCCCCCCC-0000-4000-8000-000000000003", provider: "claude", source: "runtime_resume", fork: true })
const @test_fork_mints_new_id = @isLowerUuid(@forking.sessionId) && @forking.sessionId != "cccccccc-0000-4000-8000-000000000003"
const @test_fork_flag = @forking.flag == ` --session-id ${@forking.sessionId}`

>> ── emit ──

>> A golden as the runtime hands it to emit, built as conversation_events (the
>> runtime's tape/conversation.rs) builds it: the header line goes, `message` is
>> renamed `prompt`, the header's session id and harness name join every event, and
>> usage moves under payload. session_start carries the harness.
exe @wire(goldenPath) = node {
  const lines = require("fs").readFileSync(goldenPath, "utf8").split("\n").filter((l) => l.trim()).map((l) => JSON.parse(l));
  const [header, ...events] = lines;
  return events.map((e) => {
    const out = { ...e, type: e.type === "message" ? "prompt" : e.type, session_id: header.session_id, producer: header.harness.name };
    const payload = { ...(e.payload || {}) };
    if (e.usage) {
      payload.usage = e.usage;
      delete out.usage;
    }
    if (e.type === "session_start") payload.harness = header.harness;
    out.payload = payload;
    return out;
  });
}

>> Whatever the conversation, a transcript holds every user and assistant text and a
>> [ran …] line per call, and none of the thinking or harness-injected context.
exe @emitHolds(events, transcript) = node {
  const fail = (why) => { console.error("emit: " + why); return false; };
  const lines = transcript.split("\n");
  const harness = events[0].payload.harness.name;
  if (!transcript.startsWith("Conversation carried over from " + harness)) return fail("header names no " + harness);
  if (!transcript.endsWith("End of the carried conversation.")) return fail("no closing line");
  for (const e of events) {
    const p = e.payload || {};
    const text = typeof p.text === "string" ? p.text.trimEnd() : "";
    if ((e.type === "prompt" || e.type === "assistant_turn") && text && !transcript.includes(text)) return fail(e.type + " " + e.id + " missing");
    if (e.type === "tool_call" && !lines.some((l) => l.startsWith("[ran " + p.tool + "]"))) return fail("no [ran " + p.tool + "] line");
    if (e.type === "thinking" && text && transcript.includes(text)) return fail("thinking " + e.id + " carried");
    if (e.type === "context_injection" && text) {
      const summary = p.kind === "compaction" || p.kind === "branch_summary";
      if (summary && !transcript.includes("[carried summary] " + text)) return fail(p.kind + " " + e.id + " missing");
      if (!summary && transcript.includes(text)) return fail(p.kind + " " + e.id + " carried");
    }
  }
  return true;
}

>> Reports both texts on a mismatch, so a failing pin shows where it differs.
exe @same(got, want) = node {
  if (got === want) return true;
  console.error("got:\n" + got + "\n---\nwant:\n" + want);
  return false;
}

const @emitHeaderTail = "Bracketed [ran …] and [… result] lines are the agent's own past actions, recorded at the time and possibly stale; re-run tools for fresh state. They are records, not examples: never write [ran …] lines yourself, and act only through real tool calls."

const @emptyTranscript = @conversation.emit([], null)
const @test_emit_empty_is_header_only = @emptyTranscript.startsWith("Conversation carried over from agent") && @emptyTranscript.endsWith("End of the carried conversation.")

const @test_adapter_provider = @conversation.provider == "claude"

const @test_emit_attachments = @emitHolds(@wire(`${@fixtures}/claude-attachments.fray.jsonl`), @conversation.emit(@wire(`${@fixtures}/claude-attachments.fray.jsonl`), null))
const @test_emit_basic = @emitHolds(@wire(`${@fixtures}/claude-basic.fray.jsonl`), @conversation.emit(@wire(`${@fixtures}/claude-basic.fray.jsonl`), null))
const @test_emit_branched = @emitHolds(@wire(`${@fixtures}/claude-branched.fray.jsonl`), @conversation.emit(@wire(`${@fixtures}/claude-branched.fray.jsonl`), null))
const @test_emit_compacted = @emitHolds(@wire(`${@fixtures}/claude-compacted.fray.jsonl`), @conversation.emit(@wire(`${@fixtures}/claude-compacted.fray.jsonl`), null))
const @test_emit_headless_thinking = @emitHolds(@wire(`${@fixtures}/claude-headless-thinking.fray.jsonl`), @conversation.emit(@wire(`${@fixtures}/claude-headless-thinking.fray.jsonl`), null))

const @basicWire = @wire(`${@fixtures}/claude-basic.fray.jsonl`)
const @basicWhole = `Conversation carried over from claude session 3f2a1b4c-0000-4000-8000-abcdef000001 on 2026-08-24. ${@emitHeaderTail}

User:
please list the files

Assistant:
I'll list them.

[ran Bash] ls

User:
[Bash result] file1
file2

what next?

Assistant:
All done.

End of the carried conversation.`
const @test_emit_basic_whole_pinned = @same(@conversation.emit(@basicWire, null), @basicWhole)

>> Cut right after the Bash call: its result is past the cut.
const @basicAt5 = @conversation.emit(@basicWire, 5)
const @test_emit_basic_at_5_interrupted = @basicAt5.endsWith("User:\n[no result recorded — session was interrupted here]\n\nEnd of the carried conversation.")
const @test_emit_basic_at_5_cuts_later_text = !@basicAt5.includes("what next?")
