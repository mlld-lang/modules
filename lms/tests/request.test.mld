>> Tests for the request body @lms sends, with no server.
>> Run: mlld test lms/tests/

import { @lmsRequest, @lmsResult } from "../index.mld"

const @bare = @lmsRequest("hi", {})
const @test_bare_has_only_user_turn = @bare.messages.length == 1 && @bare.messages[0].content == "hi"
const @test_bare_model_empty = @bare.model == ""
const @test_bare_sends_no_optional_fields = @bare.temperature == null && @bare.max_tokens == null && @bare.response_format == null

const @full = @lmsRequest("next", {
  model: "gemma",
  system: "be brief",
  messages: [{ role: "user", content: "a" }, { role: "assistant", content: "b" }],
  temperature: 0,
  maxTokens: 64,
  ttl: 30
})
const @test_system_comes_first = @full.messages[0].role == "system"
const @test_history_before_prompt = @full.messages[2].content == "b" && @full.messages[3].content == "next"
const @test_zero_temperature_kept = @full.temperature == 0
const @test_max_tokens_renamed = @full.max_tokens == 64
const @test_ttl_passed = @full.ttl == 30

const @schema = { type: "object", properties: { a: { type: "string" } } }
const @withSchema = @lmsRequest("x", { schema: @schema })
const @test_schema_becomes_json_schema = @withSchema.response_format.type == "json_schema"
const @test_schema_name_defaults = @withSchema.response_format.json_schema.name == "response"
const @test_schema_is_strict = @withSchema.response_format.json_schema.strict
const @test_response_format_overrides_schema = @lmsRequest("x", { schema: @schema, responseFormat: { type: "json_object" } }).response_format.type == "json_object"

>> ── reading the reply (the { status, body, ok } record @http returns) ──

const @reply = { ok: true, status: 200, body: { model: "qwen", choices: [{ message: { content: "pong" }, finish_reason: "stop" }], usage: { total_tokens: 7 } } }
const @test_reply_text = @lmsResult(@reply, "", false) == "pong"
const @fullReply = @lmsResult(@reply, "", true)
const @test_full_shape = @fullReply.content == "pong" && @fullReply.model == "qwen" && @fullReply.usage.total_tokens == 7 && @fullReply.finishReason == "stop"

const @sparse = { ok: true, status: 200, body: { choices: [{ message: { content: null } }] } }
const @bareFull = @lmsResult(@sparse, "asked-model", true)
const @test_missing_fields_default = @bareFull.content == "" && @bareFull.model == "asked-model" && @bareFull.usage == null && @bareFull.finishReason == null
const @test_null_content_is_empty_text = @lmsResult(@sparse, "", false) == ""

const @failed = try @lmsResult({ ok: false, status: 500, body: "server exploded" }, "", false)
const @test_non_2xx_raises = !@failed.ok && @failed.error.message == "LM Studio REST 500: server exploded"
