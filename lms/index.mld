needs { network }

>> ── Request ──
>> The chat/completions body, built in mlld so it can be read and tested apart
>> from the network call.
exe @lmsRequest(prompt, cfg) = [
  let @sys = @cfg.system ? [{ role: "system", content: @cfg.system }] : []
  let @prior = @cfg.messages && @cfg.messages.isArray() ? @cfg.messages : []
  let @temperature = @cfg.temperature != null ? { temperature: @cfg.temperature } : {}
  let @maxTokens = @cfg.maxTokens != null ? { max_tokens: @cfg.maxTokens } : {}
  let @ttl = @cfg.ttl != null ? { ttl: @cfg.ttl } : {}
  let @format = match [
    @cfg.responseFormat => { response_format: @cfg.responseFormat }
    @cfg.schema => {
      response_format: {
        type: "json_schema",
        json_schema: { name: @cfg.schemaName ?? "response", strict: true, schema: @cfg.schema }
      }
    }
    * => {}
  ]
  => {
    model: @cfg.model ?? "",
    messages: [...@sys, ...@prior, { role: "user", content: @prompt }],
    ...@temperature,
    ...@maxTokens,
    ...@ttl,
    ...@format
  }
]

>> ── Response ──

>> js because mlld has no throw; a thrown error is what lets callers catch it with `try`.
exe @raise(message) = js {
  throw new Error(message);
}

>> LM Studio returns the model's final answer in choices[0].message.content with
>> reasoning split out, so there is no <think> stripping. `full` returns
>> { content, model, usage, finishReason }. A non-2xx status raises.
exe @lmsResult(res, requestedModel, full) = [
  if !@res.ok [ => @raise(`LM Studio REST ${@res.status}: ${@res.body}`) ]
  let @choice = @res.body.choices[0]
  let @content = @choice.message.content || ""
  => match [
    @full => {
      content: @content,
      model: @res.body.model || @requestedModel || "",
      usage: @res.body.usage ?? null,
      finishReason: @choice.finish_reason ?? null
    }
    * => @content
  ]
]

>> ── Network call ──

>> The API key is optional and belongs to the caller's local server, so it goes
>> in a header here rather than through a declared credential.
exe @lmsPost(body, baseUrl, apiKey, full) = [
  let @givenBase = @baseUrl || "http://localhost:1234/v1"
  let @base = @givenBase.endsWith("/") ? @givenBase.slice(0, -1) : @givenBase
  let @auth = @apiKey ? { Authorization: `Bearer ${@apiKey}` } : {}
  let @res = @http.request(`${@base}/chat/completions`, {
    method: "POST",
    headers: { "Content-Type": "application/json", ...@auth },
    body: @body
  })
  => @lmsResult(@res, @body.model, @full)
]

>> ── Public API ──
>> @lms(prompt, config) — call a local LM Studio model over its REST API.
>> config.model          - model id (default: server's loaded model)
>> config.system         - system prompt
>> config.messages       - prior conversation turns (array of {role, content})
>> config.temperature    - sampling temperature
>> config.maxTokens      - max output tokens
>> config.schema         - JSON Schema object → guaranteed structured output
>> config.schemaName     - name for the schema (default: "response")
>> config.responseFormat - raw response_format passthrough (overrides schema)
>> config.ttl            - seconds to keep the model loaded after the call
>> config.baseUrl        - API base URL (default: http://localhost:1234/v1)
>> config.apiKey         - bearer token, if the server requires auth
>> config.full           - return { content, model, usage, finishReason }
llm @lms(prompt, config) = [
  let @cfg = @config ? @config : {}
  => @lmsPost(@lmsRequest(@prompt, @cfg), @cfg.baseUrl, @cfg.apiKey, @cfg.full)
]

export { @lms, @lmsRequest, @lmsResult }
